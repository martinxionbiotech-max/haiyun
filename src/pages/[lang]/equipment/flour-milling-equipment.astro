    gallery: [
      'eq-6f-single-roller-mill.jpg', 'eq-fmfq-double-roller-mill.jpg',
      'eq-purifier.jpg', 'eq-single-bin-plansifter.jpg',
      'eq-double-bin-plansifter.jpg', 'eq-high-square-plansifter.jpg',
      'eq-bran-finisher.jpg', 'eq-impact-detacher.jpg',
      'eq-automatic-packer.jpg', 'eq-pulse-jet-dust-collector.jpg',
