---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import { equipmentCategories, equipmentByCategory } from '../../../data/equipment.js';
import { getUI } from '../../../i18n/ui.js';
import { translatedLocales, localeMeta, localizePath } from '../../../i18n/config.js';
import { getEquipmentContent } from '../../../i18n/content.js';

export function getStaticPaths() {
  return translatedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
const t = getUI(lang);
const meta = localeMeta[lang];

const copy = {
  ru: {
    eyebrow: 'Каталог оборудования',
    hero: 'Все машины от автомобильных весов до мешка муки',
    sub: 'Двадцать три семейства оборудования, каждое с полными таблицами параметров, критериями выбора и интервалами обслуживания. От одной камнеотборки до целого помольного отделения на 500 т/сут.',
    catBlurb: {
      cleaning: 'Всё между автомобильными весами и бункером отволаживания: просеиватели, камнеотборники, обоечные машины, мойки, увлажнители, магниты и аспираторы.',
      milling: 'Вальцовые станки, рассевы, ситовейки, вымольные машины, деташеры, упаковщики и фильтры — ядро любой мельницы.',
    },
    families: 'семейств машин',
    cta: 'Отправить спецификацию — получите подбор оборудования',
  },
  es: {
    eyebrow: 'Catálogo de equipos',
    hero: 'Toda la máquina entre el pesaje y el saco de harina',
    sub: 'Veintitrés familias de equipos, cada una con tablas completas de parámetros, criterios de selección e intervalos de mantenimiento. Desde un despedregador hasta una sala de molienda completa de 500 t/día.',
    catBlurb: {
      cleaning: 'Todo lo que hay entre el pesaje y la tolva de reposo: tamices, despedregadores, descascarilladores, lavadoras, humectadores, imanes y aspiradores.',
      milling: 'Bancos de cilindros, cernidores, purificadores, desmenuzadoras de salvado, desagregadores, ensacadoras y filtros — el núcleo de cualquier molino.',
    },
    families: 'familias de máquinas',
    cta: 'Envíe su especificación y reciba una propuesta de equipos',
  },
  ar: {
    eyebrow: 'كتالوج المعدات',
    hero: 'كل ماكينة بين الميزان وكيس الدقيق',
    sub: 'ثلاث وعشرون عائلة معدات، لكل منها جداول مواصفات كاملة ومعايير اختيار وفترات صيانة. من فارزة حجر واحدة إلى صالة طحن كاملة بطاقة 500 طن يوميًا.',
    catBlurb: {
      cleaning: 'كل ما بين الميزان وصومعة التندية: مناخل، وفارزات حجر، وفرّاكا، وغسالات، ومرطبات، ومغناطيسات، وشوارد.',
      milling: 'حوامل الدرفيل، والمناخل، ومكنات التنقية، وفارزات النخالة، ومفككات التكتل، والتعبئة، والفلاتر — جوهر أي مطحن.',
    },
    families: 'عائلات ماكينات',
    cta: 'أرسل مواصفاتك واحصل على ترشيح للمعدات',
  },
};

const c = copy[lang];
const href = (p) => localizePath(lang, p);

// Detail pages exist in every locale now, so the cards show translated names and
// taglines and link to the localised page rather than dropping the reader back
// into English one click after the language switch.
const localized = {};
for (const cat of equipmentCategories) {
  localized[cat.id] = await Promise.all(
    equipmentByCategory(cat.id).map((e) => getEquipmentContent(lang, e.slug))
  );
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.hero,
  description: c.sub,
  inLanguage: meta.htmlLang,
};
---

<PageLayout title={c.hero} description={c.sub} lang={lang} schema={[schema]}>
  <PageHero
    eyebrow={c.eyebrow}
    title={c.hero}
    subtitle={c.sub}
    image="/images/p24_01.jpg"
    imageAlt={c.hero}
    lang={lang}
  />

  {equipmentCategories.map((cat) => {
    const items = localized[cat.id];
    return (
      <section class="section hairline">
        <div class="container-x">
          <div class="max-w-3xl">
            <p class="eyebrow">{items.length} {c.families}</p>
            <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
              {cat.id === 'cleaning' ? t.equipment.cleaning : t.equipment.milling}
            </h2>
            <p class="mt-3 text-[15px] leading-relaxed text-steel-600">{c.catBlurb[cat.id]}</p>
          </div>

          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {items.map((e) => (
              <a href={href(`/equipment/${e.slug}/`)} class="card group flex flex-col p-6">
                <div class="flex items-start justify-between gap-3">
                  <span class="rounded bg-steel-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-steel-600" dir="ltr">
                    {e.model}
                  </span>
                  <span class="text-[10px] font-semibold uppercase tracking-wider text-steel-400">{e.stage}</span>
                </div>
                <h3 class="mt-3 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
                  {e.name}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-steel-600">{e.tagline}</p>
                <p class="mt-4 text-xs font-semibold text-steel-500">{e.specs.rows.length} {t.equipment.specs} →</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section bg-steel-50">
    <div class="container-x">
      <div class="rounded-xl border border-steel-200 bg-white p-6">
        <p class="text-sm leading-relaxed text-steel-600">{t.specNote}</p>
      </div>
    </div>
  </section>

  <CTABand lang={lang} heading={c.cta} body={t.home.ctaBandBody} />
</PageLayout>
