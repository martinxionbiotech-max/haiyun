---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import { plantSeries } from '../../../data/plants.js';
import { getPlantContent } from '../../../i18n/content.js';
import { getUI } from '../../../i18n/ui.js';
import { translatedLocales, localeMeta, localizePath } from '../../../i18n/config.js';

export function getStaticPaths() {
  return translatedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
const t = getUI(lang);
const meta = localeMeta[lang];
const href = (p) => localizePath(lang, p);
const localizedPlants = plantSeries.map((p) => getPlantContent(lang, p.slug));

const copy = {
  ru: {
    eyebrow: 'Модельный ряд',
    hero: 'Мельничные заводы от 200 кг/ч до 500 т/сут',
    sub: 'Семь архитектур и более тридцати конфигураций: схема очистки, схема помола и габариты здания для каждой.  Полные таблицы параметров. и схемы очистки.',
    h2: 'Мощность определяет архитектуру. Архитектура определяет стоимость.',
    p1: 'Мельница — это не товар, который покупают, а архитектура, которую выбирают. До 18 т/сут завод можно разместить в ангаре на бетонной плите. Свыше 40 т/сут нужна ситовейка, значит нужна схема, значит нужно здание, спроектированное под схему. Свыше 100 т/сут здание само становится машиной: этажное, с гравитационным потоком, спроектированное как единая система.',
    p2: 'Поэтому модельный ряд сгруппирован по архитектуре, а не по цене. Выберите группу под ваш тоннаж, затем модель внутри группы — по зданию, электроснабжению и ассортименту.',
    groups: [
      ['Начальный уровень — 200 кг/ч до 18 т/сут', 'Моноблочные установки и малые заводы. Без башни, минимум строительных работ, пуск за считаные дни.'],
      ['Коммерческий — 20 до 60 т/сут', 'Полные секции очистки, рассевы, ситовейки, многосортное производство. Основа рынка.'],
      ['Промышленный — 60 до 500 т/сут', 'Этажные заводы под ключ с гарантией тоннажа, выхода и удельного расхода энергии.'],
    ],
    capacity: 'Производительность',
    models: 'Модели',
    view: 'Смотреть параметры',
    matrixEyebrow: 'Матрица выбора',
    matrixTitle: 'Что реально требует каждый класс мощности',
    tableHead: ['Мощность', 'Здание', 'Очистка', 'Помол', 'Просеивание', 'Человек/смена', 'Срок поставки'],
    notice: 'Подробные технические описания моделей опубликованы на английском — их читают инженеры-мельники.',
    noticeLink: 'Открыть техническое описание',
  },
  es: {
    eyebrow: 'Gama de plantas',
    hero: 'Plantas de molienda de 200 kg/h a 500 t/día',
    sub: 'Siete arquitecturas y más de treinta configuraciones estándar, cada una con diagrama de limpieza, diagrama de molienda y dimensiones de edificio.',
    h2: 'La capacidad decide la arquitectura. La arquitectura decide el coste.',
    p1: 'Una planta de harina no es un producto que se compra, sino una arquitectura a la que se compromete. Por debajo de 18 t/día se puede montar en una nave con losa de hormigón. Por encima de 40 t/día hace falta un purificador, lo que exige un diagrama, lo que exige un edificio diseñado alrededor del diagrama. Por encima de 100 t/día el edificio es la máquina: de varias alturas, por gravedad, concebido como un solo sistema.',
    p2: 'Por eso la gama se agrupa por arquitectura y no por precio. Elija el grupo según su tonelaje y luego el modelo dentro del grupo según su edificio, su suministro eléctrico y su mezcla de productos.',
    groups: [
      ['Nivel de entrada — 200 kg/h a 18 t/día', 'Unidades monocuerpo y plantas pequeñas. Sin torre, mínima obra civil, puesta en marcha en días.'],
      ['Comercial — 20 a 60 t/día', 'Secciones de limpieza completas, cernidores, purificadores, producción multiclase. El núcleo del mercado.'],
      ['Industrial — 60 a 500 t/día', 'Plantas de varias alturas llave en mano con tonelaje, rendimiento y consumo específico garantizados.'],
    ],
    capacity: 'Capacidad',
    models: 'Modelos',
    view: 'Ver especificaciones',
    matrixEyebrow: 'Matriz de selección',
    matrixTitle: 'Lo que realmente exige cada clase de capacidad',
    tableHead: ['Capacidad', 'Edificio', 'Limpieza', 'Molienda', 'Tamizado', 'Personas/turno', 'Plazo típico'],
    notice: 'Las fichas técnicas detalladas de cada modelo se publican en inglés: las leen ingenieros de molino.',
    noticeLink: 'Abrir ficha técnica',
  },
  ar: {
    eyebrow: 'نطاق المصانع',
    hero: 'مصانع طحن من 200 كجم/ساعة إلى 500 طن/يوم',
    sub: 'سبع معماريات وأكثر من ثلاثين تكوينًا قياسيًا، لكل منها مخطط تنظيف ومخطط طحن وأبعاد مبنى محددة.  مع جداول المواصفات الكاملة. وتُسلَّم مع الجداول.',
    h2: 'الطاقة تحدد المعمارية. والمعمارية تحدد التكلفة.',
    p1: 'مصنع الدقيق ليس منتجًا يُشترى، بل معمارية يُلتزم بها. تحت 18 طنًا يوميًا يمكن البناء داخل سقيفة على بلاطة خرسانية. وفوق 40 طنًا يوميًا تحتاج مكنة تنقية، أي تحتاج مخططًا، أي تحتاج مبنى مصممًا حول المخطط. وفوق 100 طن يوميًا يصبح المبنى نفسه هو الماكينة: متعدد الطوابق، بالجاذبية، مهندس كنظام واحد.',
    p2: 'لهذا جُمع النطاق حسب المعمارية لا حسب السعر. اختر المجموعة المناسبة لإنتاجيتك، ثم اختر الموديل داخلها حسب مبناك وتغذيتك الكهربائية ومزيج منتجاتك.',
    groups: [
      ['المستوى الأول — من 200 كجم/ساعة إلى 18 طن/يوم', 'وحدات أحادية الهيكل ومصانع صغيرة. بلا برج، وأعمال مدنية محدودة، وتشغيل خلال أيام.'],
      ['تجاري — من 20 إلى 60 طن/يوم', 'أقسام تنظيف كاملة ومناخل ومكنات تنقية وإنتاج متعدد الدرجات. جوهر السوق.'],
      ['صناعي — من 60 إلى 500 طن/يوم', 'مصانع متعددة الطوابق تسليم مفتاح بإنتاجية واستخلاص واستهلاك نوعي مضمونة.'],
    ],
    capacity: 'الطاقة',
    models: 'الموديلات',
    view: 'عرض المواصفات',
    matrixEyebrow: 'مصفوفة الاختيار',
    matrixTitle: 'ما تتطلبه كل فئة إنتاجية فعليًا',
    tableHead: ['الطاقة', 'المبنى', 'التنظيف', 'الطحن', 'النخل', 'أفراد/وردية', 'مدة التنفيذ'],
    notice: 'المواصفات الفنية التفصيلية لكل موديل منشورة بالإنجليزية، لأن مهندسي المطاحن يعملون بها.',
    noticeLink: 'فتح المواصفات الفنية',
  },
};

const c = copy[lang];

const groups = [
  { title: c.groups[0][0], note: c.groups[0][1], items: localizedPlants.filter((p) => ['small-unit', 'double-unit', 'five-unit', 'stone-mill'].includes(p.id)) },
  { title: c.groups[1][0], note: c.groups[1][1], items: localizedPlants.filter((p) => ['plant-20-30', 'plant-40-60'].includes(p.id)) },
  { title: c.groups[2][0], note: c.groups[2][1], items: localizedPlants.filter((p) => ['plant-100-500'].includes(p.id)) },
];

const tableRows = [
  ['200–400 kg/h', 'Плита + ангар', 'Опц. одна ступень', '1–2 станка', 'Встроенное', '1', '30–45 дней'],
  ['16–18 т/сут', 'Пролёт 10 × 5 × 3,5 м', 'Камнеотборник + обоечная + мойка', '2 станка, 3B2M', 'Конус или двухсекционный', '3', '60–80 дней'],
  ['20–30 т/сут', '12–18 × 5–6 м', 'Полная сухая секция', '5–10 станков, 3B2M–4B4M', '2 двухсекционных', '3–4', '80–100 дней'],
  ['40–60 т/сут', '18–24 × 8 × 8 м', 'Полная сухая + 2 обоечные', '8–12 станков, 3B4M1S–4B5M1S1T', 'Высокий рассев + ситовейка', '4–6', '100–130 дней'],
  ['60–500 т/сут', 'Этажная башня', '3 просеивания / 2 обоечные / 2 камнеотборника', 'Мультипроход, батареи ситовеек', 'Батареи высоких рассевов', '8–30', '8–11 мес.'],
];

const tableRowsEs = [
  ['200–400 kg/h', 'Losa + nave', 'Una etapa opcional', '1–2 bancos', 'Integrado', '1', '30–45 días'],
  ['16–18 t/día', 'Bahía 10 × 5 × 3,5 m', 'Despedregador + descascarillador + lavado', '2 bancos, 3B2M', 'Cónico o doble compartimento', '3', '60–80 días'],
  ['20–30 t/día', '12–18 × 5–6 m', 'Sección seca completa', '5–10 bancos, 3B2M–4B4M', '2 de doble compartimento', '3–4', '80–100 días'],
  ['40–60 t/día', '18–24 × 8 × 8 m', 'Seca completa + 2 descascarilladores', '8–12 bancos, 3B4M1S–4B5M1S1T', 'Cernidor alto + purificador', '4–6', '100–130 días'],
  ['60–500 t/día', 'Torre de varias alturas', '3 tamices / 2 descascarilladores / 2 despedregadores', 'Multipaso, baterías de purificadores', 'Baterías de cernidores altos', '8–30', '8–11 meses'],
];

const tableRowsAr = [
  ['200–400 كجم/ساعة', 'بلاطة + سقيفة', 'مرحلة واحدة اختيارية', '1–2 حامل', 'مدمج', '1', '30–45 يومًا'],
  ['16–18 طن/يوم', 'خليج 10 × 5 × 3.5 م', 'فارزة حجر + فرّاكة + غسالة', 'حاملان، 3B2M', 'مخروطي أو مزدوج', '3', '60–80 يومًا'],
  ['20–30 طن/يوم', '12–18 × 5–6 م', 'قسم جاف كامل', '5–10 حوامل، 3B2M–4B4M', 'منخلان مزدوجان', '3–4', '80–100 يوم'],
  ['40–60 طن/يوم', '18–24 × 8 × 8 م', 'جاف كامل + فرّاكتان', '8–12 حاملًا، 3B4M1S–4B5M1S1T', 'منخل عالٍ + مكنة تنقية', '4–6', '100–130 يومًا'],
  ['60–500 طن/يوم', 'برج متعدد الطوابق', '3 مناخل / 2 فرّاكة / 2 فارزة', 'متعدد المرور، بطاريات تنقية', 'بطاريات مناخل عالية', '8–30', '8–11 شهرًا'],
];

const rows = lang === 'ru' ? tableRows : lang === 'es' ? tableRowsEs : tableRowsAr;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.hero,
  description: c.sub,
  inLanguage: meta.htmlLang,
};
---

<PageLayout title={c.hero} description={c.sub} lang={lang} schema={[schema]}>
  <PageHero
    eyebrow={c.eyebrow}
    title={c.hero}
    subtitle={c.sub}
    image="/images/p06_01.webp"
    imageAlt={c.hero}
    lang={lang}
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">{c.h2}</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">{c.p1}</p>
        <p class="mt-3 text-[15px] leading-relaxed text-steel-700">{c.p2}</p>
      </div>
    </div>
  </section>

  {groups.map((group) => (
    <section class="pb-16">
      <div class="container-x">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-steel-200 pb-4">
          <h2 class="font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">{group.title}</h2>
          <p class="max-w-md text-sm text-steel-500">{group.note}</p>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {group.items.map((p) => (
            <a href={`/flour-milling-plant/${p.slug}/`} class="card group flex flex-col p-6">
              <p class="text-[11px] font-bold uppercase tracking-widest text-ember-600">{p.capacity}</p>
              <h3 class="mt-2 font-display text-xl font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
                {p.name}
              </h3>
              <p class="mt-1 text-xs font-medium text-steel-500">{p.altName}</p>
              <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-steel-100 pt-4 text-sm">
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-steel-500">{c.capacity}</dt>
                  <dd class="font-bold text-steel-900">{p.capacity}</dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-steel-500">{c.models}</dt>
                  <dd class="font-bold text-steel-900">{p.models.length}</dd>
                </div>
              </dl>
              <span class="mt-4 text-sm font-semibold text-ember-700">{c.view} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section bg-steel-50">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">{c.matrixEyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">{c.matrixTitle}</h2>
      </div>
      <div class="mt-8 overflow-x-auto rounded-xl border border-steel-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-steel-900 text-white">
            <tr>
              {c.tableHead.map((h) => (
                <th class="px-4 py-3 text-start text-[11px] font-bold uppercase tracking-widest">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-steel-100">
            {rows.map((row) => (
              <tr class="hover:bg-steel-50">
                {row.map((cell, j) => (
                  <td class={`px-4 py-3 ${j === 0 ? 'font-semibold text-steel-900' : 'text-steel-700'}`}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-4 rounded-lg border border-steel-200 bg-white p-4 text-sm leading-relaxed text-steel-600">
        {c.notice}
      </p>
    </div>
  </section>

  <CTABand lang={lang} heading={t.home.ctaBand} body={t.home.ctaBandBody} />
</PageLayout>
