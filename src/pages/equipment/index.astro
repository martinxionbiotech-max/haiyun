---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { equipmentCategories, equipment, equipmentByCategory } from '../../data/equipment.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Flour Milling & Grain Cleaning Equipment',
  description: '22 equipment families for wheat flour milling: cleaning, destoning, scouring, dampening, roller mills, plansifters, purifiers and packing.',
};
---

<PageLayout
  title="Flour Milling & Grain Cleaning Equipment — 22 Equipment Families"
  description="Complete equipment catalogue for wheat flour mills: drum sieves, destoners, scourers, dampeners, magnets, roller mills, plansifters, purifiers, bran finishers, packers and dust collectors. Full parameter tables."
  schema={[schema]}
>
  <PageHero
    eyebrow="Equipment catalogue"
    title="Every machine between the weighbridge and the flour bag"
    subtitle="Twenty-two equipment families, each with full parameter tables, selection criteria and maintenance intervals. Buy a single destoner or an entire 500 t/d grinding floor."
    image="/images/p24_01.jpg"
    imageAlt="Roller mill with synchronous belt drive — flour milling equipment"
  />

  {equipmentCategories.map((cat) => {
    const items = equipmentByCategory(cat.id);
    return (
      <section class="section hairline" aria-labelledby={`cat-${cat.id}`}>
        <div class="container-x">
          <div class="max-w-3xl">
            <p class="eyebrow">{items.length} machine families</p>
            <h2 id={`cat-${cat.id}`} class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
              {cat.name}
            </h2>
            <p class="mt-3 text-[15px] leading-relaxed text-steel-600">{cat.blurb}</p>
          </div>

          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {items.map((e) => (
              <a href={`/equipment/${e.slug}/`} class="card group flex flex-col p-6">
                <div class="flex items-start justify-between gap-3">
                  <span class="rounded bg-steel-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-steel-600">
                    {e.stage}
                  </span>
                  <span class="text-[11px] font-bold text-ember-600">{e.model}</span>
                </div>
                <h3 class="mt-3 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
                  {e.name}
                </h3>
                <p class="mt-0.5 text-xs text-steel-500">{e.altName}</p>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-steel-600">{e.tagline}</p>
                <span class="mt-4 text-sm font-semibold text-ember-700">Specifications →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

  <section class="section bg-steel-50">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">Full index</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          All 22 equipment families
        </h2>
      </div>
      <div class="prose-hy mt-8">
        <table>
          <thead>
            <tr><th>Equipment</th><th>Model</th><th>Process stage</th><th>Capacity range</th></tr>
          </thead>
          <tbody>
            {equipment.map((e) => (
              <tr>
                <td><a href={`/equipment/${e.slug}/`} class="font-semibold">{e.name}</a></td>
                <td class="font-mono text-xs">{e.model}</td>
                <td>{e.stage}</td>
                <td class="text-sm">{e.specs.rows.length > 0 ? e.specs.rows[e.specs.rows.length - 1][1] : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTABand heading="Not sure which machine your flow sheet is missing?" />
</PageLayout>
