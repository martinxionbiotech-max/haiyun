---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Figure from '../../components/Figure.astro';
import FAQ from '../../components/FAQ.astro';
import CTABand from '../../components/CTABand.astro';
import { equipment, equipmentByCategory } from '../../data/equipment.js';
import { equipmentGallery } from '../../data/gallery.js';
import { site } from '../../data/site.js';

export async function getStaticPaths() {
  return equipment.map((e) => ({ params: { slug: e.slug }, props: { item: e } }));
}

const { item } = Astro.props;
const related = equipment.filter((e) => e.category === item.category && e.slug !== item.slug).slice(0, 4);
const shots = equipmentGallery[item.slug] ?? { hero: null, gallery: [] };
const heroFile = shots.hero;
const galleryFiles = shots.gallery.filter((f) => f !== heroFile);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${item.name} (${item.model})`,
    description: item.tagline,
    brand: { '@type': 'Brand', name: 'HAIYUN' },
    manufacturer: { '@id': `${site.url}/#organization` },
    category: item.category === 'cleaning' ? 'Grain cleaning equipment' : 'Flour milling equipment',
    model: item.model,
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      seller: { '@id': `${site.url}/#organization` },
      url: `${site.url}/equipment/${item.slug}/`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: `${item.name} — specifications, selection and maintenance`,
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    datePublished: '2026-01-15',
    dateModified: '2026-11-07',
  },
];
---

<PageLayout
  title={`${item.name} — ${item.model} Specifications`}
  description={`${item.tagline} ${item.name} (${item.model}) full parameter table, selection guidance and maintenance intervals from a manufacturer with 60+ years of grain machinery experience.`}
  schema={schema}
>
  <PageHero
    eyebrow={`${item.stage} · Model ${item.model}`}
    title={item.name}
    subtitle={item.tagline}
    image={heroFile ? `/images/${heroFile}` : undefined}
    imageAlt={`${item.name} ${item.model} — ${item.tagline}`}
  >
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <nav class="mb-6 text-xs text-steel-500" aria-label="Breadcrumb">
          <a href="/equipment/" class="hover:text-ember-700">Equipment</a>
          <span class="mx-1.5">/</span>
          <a href={item.category === 'cleaning' ? '/equipment/cleaning-equipment/' : '/equipment/flour-milling-equipment/'} class="hover:text-ember-700">
            {item.category === 'cleaning' ? 'Cleaning equipment' : 'Milling equipment'}
          </a>
          <span class="mx-1.5">/</span>
          <span class="text-steel-700">{item.name}</span>
        </nav>

        <h2 class="font-display text-2xl font-bold uppercase tracking-tight text-steel-900">What it does</h2>
        <p class="mt-3 text-[16px] leading-relaxed text-steel-700">{item.intro}</p>

        {item.highlights && (
          <>
            <h2 class="mt-10 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">Key features</h2>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {item.highlights.map((h) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-steel-700">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-ember-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/>
                  </svg>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </>
        )}

        <h2 class="mt-10 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">Technical parameters</h2>
        <p class="mt-2 text-xs text-steel-500">
          Nominal values at standard conditions. Confirm final specification on the order drawing.
        </p>
        <div class="mt-4 overflow-x-auto rounded-lg border border-steel-200">
          <table class="w-full border-collapse text-sm">
            <thead class="bg-steel-50 text-left">
              <tr>
                {item.specs.headers.map((h) => (
                  <th class="whitespace-nowrap border-b border-steel-200 px-3 py-2.5 text-xs font-bold uppercase tracking-wide text-steel-800">
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {item.specs.rows.map((row) => (
                <tr class="even:bg-steel-50/50">
                  {row.map((cell, i) => (
                    <td class:list={['border-b border-steel-100 px-3 py-2.5', i === 0 ? 'font-semibold text-steel-900' : 'text-steel-700']}>
                      {cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-steel-200 bg-steel-50 p-5">
            <h3 class="text-xs font-bold uppercase tracking-widest text-ember-700">Selection guidance</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-700">{item.selection}</p>
          </div>
          <div class="rounded-lg border border-steel-200 bg-white p-5 shadow-card">
            <h3 class="text-xs font-bold uppercase tracking-widest text-steel-600">Maintenance</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-700">{item.maintenance}</p>
          </div>
        </div>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-xl border border-steel-200 bg-steel-900 p-6 text-white">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ember-400">Model series</p>
          <p class="mt-2 font-display text-3xl font-bold uppercase">{item.model}</p>
          <p class="mt-1 text-sm text-steel-400">{item.specs.rows.length} configurations</p>
          <dl class="mt-5 space-y-2.5 border-t border-steel-800 pt-4 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">Process stage</dt>
              <dd class="text-right font-semibold">{item.stage}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">Category</dt>
              <dd class="text-right font-semibold">{item.category === 'cleaning' ? 'Cleaning' : 'Milling'}</dd>
            </div>
          </dl>
          <a href="/contact/" class="btn-primary mt-6 w-full justify-center">Get a quotation</a>
          <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn-ghost-light mt-2 w-full justify-center">
            WhatsApp
          </a>
        </div>

        <div class="mt-6 rounded-xl border border-steel-200 p-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-steel-500">Related equipment</p>
          <ul class="mt-4 space-y-3 text-sm">
            {related.map((r) => (
              <li>
                <a href={`/equipment/${r.slug}/`} class="group block">
                  <span class="block font-semibold text-steel-800 group-hover:text-ember-700">{r.name}</span>
                  <span class="block text-xs text-steel-500">{r.model} · {r.stage}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <FAQ faq={item.faq} />

  {
    galleryFiles.length > 0 && (
      <section class="section pt-0">
        <div class="container-x">
          <p class="eyebrow">From the brochure</p>
          <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">
            {item.name} — catalogue images
          </h2>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-steel-600">
            Photographs and parameter panels reproduced from the 2026 catalogue. Captions are the
            original brochure text.
          </p>
          <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {galleryFiles.map((f, i) => (
              <Figure file={f} ratio="4/3" index={i + 1} showNote />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABand />
</PageLayout>
