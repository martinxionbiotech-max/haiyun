---
import EquipmentDetail from '../../components/pages/EquipmentDetail.astro';
import { equipment } from '../../data/equipment.js';

export async function getStaticPaths() {
  return equipment.map((e) => ({ params: { slug: e.slug }, props: { item: e } }));
}

const { item } = Astro.props;
---

<EquipmentDetail item={item} lang="en" />
