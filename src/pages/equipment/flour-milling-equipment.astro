---
import CategoryList from '../../components/pages/CategoryList.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }];
}

const copy = {
  eyebrow: '9 machine families',
  title: 'Flour milling equipment',
  sub: '9 milling equipment families: 6F single roller mills, FMFQ double roller mills, purifiers, single and double bin plansifters, high square plansifters, bran finishers, impact detachers, packers and dust collectors.',
  sectionTitle: 'Break, reduce, grade, purify',
  sectionBody:
    'A milling floor is a network of passages, not a collection of machines. Break rolls open the wheat and scrape endosperm off bran at a 2.5:1 differential. Reduction rolls grind the released endosperm at 1.25:1 so it is reduced by attrition rather than cut. Sifters separate by particle size, purifiers separate by density, and impact detachers break up the flakes that smooth rolls produce. Each unit below is specified by the passage it serves — and the differential ratio matters more than the motor size.',
  specLink: 'Specifications',
  galleryTitle: 'Milling machinery',
  galleryNote:
    'Every milling machine in the catalogue, shown on its own. One photograph covers all capacity variants of a machine — the frame is identical, only the roller length or sieve area changes.',
  gallery: [
    'eq-6f-single-roller-mill.webp', 'eq-fmfq-double-roller-mill.webp',
    'eq-purifier.webp', 'eq-single-bin-plansifter.webp',
    'eq-double-bin-plansifter.webp', 'eq-high-square-plansifter.webp',
    'eq-bran-finisher.webp', 'eq-impact-detacher.webp',
    'eq-automatic-packer.webp', 'eq-pulse-jet-dust-collector.webp',
  ],
  cta: 'Want a flow sheet with the right passage count?',
  catName: 'Milling equipment',
  hero: '/images/eq-fmfq-double-roller-mill.webp',
};
---

<CategoryList category="milling" lang="en" copy={copy} />
