---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { equipmentByCategory } from '../../data/equipment.js';

const items = equipmentByCategory('milling');
---

<PageLayout
  title="Flour Milling Equipment — Roller Mills, Plansifters, Purifiers"
  description="9 milling equipment families: 6F single roller mills, FMFQ double roller mills, purifiers, single and double bin plansifters, high square plansifters, bran finishers, impact detachers, packers and dust collectors."
>
  <PageHero
    eyebrow="9 machine families"
    title="Flour milling equipment"
    subtitle="A milling floor is a network of passages, not a collection of machines. Each unit below is specified by the passage it serves — and the differential ratio matters more than the motor size."
    image="/images/p25_01.jpg"
    imageAlt="FMFQ(S) double roller mill for wheat flour milling"
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-steel-900">Break, reduce, grade, purify</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
          Break rolls open the wheat and scrape endosperm off bran at a 2.5:1 differential. Reduction rolls
          grind the released endosperm at 1.25:1 so it is reduced by attrition rather than cut. Sifters
          separate by particle size, purifiers separate by density, and impact detachers break up the flakes
          that smooth rolls produce. Remove any one of these and the flow sheet collapses.
        </p>
      </div>
    </div>
  </section>

  <section class="section hairline pt-0">
    <div class="container-x">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {items.map((e) => (
          <a href={`/equipment/${e.slug}/`} class="card group flex flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <span class="rounded bg-steel-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-steel-600">{e.stage}</span>
              <span class="text-[11px] font-bold text-ember-600">{e.model}</span>
            </div>
            <h3 class="mt-3 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">{e.name}</h3>
            <p class="mt-0.5 text-xs text-steel-500">{e.altName}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-steel-600">{e.tagline}</p>
            <span class="mt-4 text-sm font-semibold text-ember-700">Specifications →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand heading="Want a flow sheet with the right passage count?" />
</PageLayout>
