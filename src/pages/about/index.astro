---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Figure from '../../components/Figure.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../data/site.js';
import { img } from '../../data/images.js';
import {
  workshops, certificates, honoursPanel, honoursWall,
  companyBanner, certificateStrip, exportBanner,
} from '../../data/gallery.js';

const coverFile = 'p01_01.jpg';
const backCoverFile = 'p29_01.jpg';

const timeline = [
  ['1963', 'Predecessor Shandong Flour Machinery Factory begins grain machinery production.'],
  ['2010', 'Company incorporated as Shandong Sishui Haiyun Grain Machine Co., Ltd.'],
  ['2013', 'ISO 9001 quality system certification and import/export licence obtained.'],
  ['2016', 'Development of buckwheat, rice and oat processing equipment lines.'],
  ['2019', 'First 200 t/d storey-typed turnkey plant commissioned.'],
  ['2021', '300 t/d plant delivered; patent count passes 100.'],
  ['2022', '500 t/d plant commissioned — largest single installation to date.'],
  ['2023', 'CE certification on selected models; export markets pass 40 countries.'],
];

// Workshop groups, each rendered with the brochure's own caption.
const workshopGroups = [
  {
    title: 'Roller mill workshop Ⅰ & Ⅱ',
    body: 'Two dedicated bays for roll stand assembly. Housings are machined on CNC centres, then assembled and aligned in these bays — roll parallelism is verified to 0.05 mm before a stand leaves the floor.',
    files: [...workshops.rollerMill1, ...workshops.rollerMill2],
  },
  {
    title: 'Integrated assembly Ⅰ & Ⅱ',
    body: 'Plansifters, purifiers and cleaning equipment are assembled and test-run here, then complete plants are pre-assembled for factory acceptance testing before crating.',
    files: [...workshops.assembly1, ...workshops.assembly2],
  },
  {
    title: 'Production workshop',
    body: 'General fabrication and machining. Plate enters as laser-cut blank; the workshop turns it into frames, spouting and structural steel for the plant.',
    files: [...workshops.overview, ...workshops.detail],
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Haiyun Grain Machine',
  description: site.description,
  mainEntity: { '@id': `${site.url}/#organization` },
  image: certificates.map((f) => `${site.url}/images/${f}`),
};
---

<PageLayout
  title="About Haiyun — Grain Machinery Manufacturer Since 1963"
  description="Shandong Sishui Haiyun Grain Machine Co., Ltd. — 60+ years of grain machinery heritage, 100+ patents, ISO 9001:2015 certification, 60,000 m² site and exports to 40+ countries."
  image={`/images/${companyBanner}`}
  schema={[schema]}
>
  <PageHero
    eyebrow="About"
    title="Sixty years of grain machinery, in one factory in Shandong"
    subtitle="The company's predecessor was the Shandong Flour Machinery Factory. That lineage is why our frames are heavier than they need to be, and why every wear part is designed to be replaced by a local workshop."
    image={`/images/${companyBanner}`}
    imageAlt={img(companyBanner).note}
  />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="eyebrow">The company</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          A national high-tech enterprise that still builds its own frames
        </h2>
        <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-steel-700">
          <p>
            Shandong Sishui Haiyun Grain Machine Co., Ltd. is located in the Sishui Economic Development
            Zone in Jining, Shandong. The company was incorporated in 2010, converted from the former
            Shandong Flour Machinery Factory, and carries more than sixty years of accumulated grain
            machinery manufacturing experience.
          </p>
          <p>
            Registered capital is CNY 12 million. The site covers more than 60,000 m², of which 20,000 m²
            is covered processing workshop. Raw material enters as laser-cut plate; roll housings are
            machined on CNC centres. Production is organised across dedicated milling machine workshops,
            an integrated assembly hall, a material cutting shop and a finished goods area.
          </p>
          <p>
            The product range has formed six systems and more than thirty products, capable of delivering
            turnkey flour plants from 10 to 500 tonnes of wheat per 24 hours. In recent years the company
            has added buckwheat, rice hulling and milling, corn flour and grits, oat and oat flake, chilli
            powder and stone grinding equipment.
          </p>
          <p>
            More than one hundred patents are held. The company is recognised as a national high-tech
            enterprise, holds an import and export products licence, and has passed ISO 9001:2015
            international quality system certification. Equipment is exported to Eastern Europe, the CIS,
            Mongolia, South Korea, Japan, South America, Africa and Southeast Asia.
          </p>
        </div>
      </div>

      <aside class="space-y-4">
        {[
          ['Founded', '2010 (lineage from 1963)'],
          ['Registered capital', 'CNY 12,000,000'],
          ['Site area', '60,000 m²'],
          ['Workshop area', '20,000 m²'],
          ['Patents', '100+'],
          ['Certifications', 'ISO 9001:2015, import/export licence'],
          ['Product systems', 'Six systems, 30+ products'],
          ['Capacity range', '10–500 t wheat/24h'],
          ['Export markets', '40+ countries'],
          ['Employees', '260+'],
        ].map(([k, v]) => (
          <div class="flex justify-between gap-4 border-b border-steel-200 pb-3 text-sm">
            <dt class="text-steel-500">{k}</dt>
            <dd class="text-right font-semibold text-steel-900">{v}</dd>
          </div>
        ))}
      </aside>
    </div>
  </section>

  {
    certificateStrip && (
      <section class="border-y border-steel-200 bg-white py-6">
        <div class="container-x">
          <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
            <p class="max-w-xl text-sm leading-relaxed text-steel-700">
              Holder of an import and export products licence, and certified to the ISO 9001:2015
              international quality management system.
            </p>
            <img
              src={`/images/${certificateStrip}`}
              alt={img(certificateStrip).note}
              class="h-10 w-auto opacity-90 sm:h-12"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-steel-50">
    <div class="container-x">
      <p class="eyebrow">Timeline</p>
      <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">Sixty years, condensed</h2>
      <ol class="mt-8 space-y-0">
        {timeline.map(([year, text]) => (
          <li class="grid gap-4 border-l-2 border-ember-500 pb-8 pl-6 sm:grid-cols-[100px_1fr] sm:gap-8">
            <p class="font-display text-xl font-bold text-ember-600">{year}</p>
            <p class="text-[15px] leading-relaxed text-steel-700">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">The workshops</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">What happens inside</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
          Dedicated bays, each with its own quality gate. Material does not move to the next stage until
          the previous one has been inspected. Photographs below are from the 2026 catalogue, with the
          brochure's own captions.
        </p>
      </div>

      <div class="mt-10 space-y-12">
        {workshopGroups.map((g) => (
          <div>
            <h3 class="font-display text-xl font-bold uppercase tracking-tight text-steel-900">{g.title}</h3>
            <p class="mt-2 max-w-3xl text-sm leading-relaxed text-steel-600">{g.body}</p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {g.files.map((f) => (
                <Figure file={f} ratio="4/3" showCaption={false} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-steel-950">
    <div class="container-x">
      <p class="eyebrow-light">Qualifications</p>
      <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl">
        Certificates, licences and honours
      </h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-steel-300">
        National high-tech enterprise status, ISO 9001:2015 quality management certification, import and
        export products licence, and provincial manufacturing awards — the paperwork an industrial buyer
        asks for during vendor qualification.
      </p>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1.6fr_1fr]">
        <div class="grid gap-4 sm:grid-cols-[1fr_auto]">
          <div class="overflow-hidden rounded-xl bg-white">
            <img
              src={`/images/${honoursWall}`}
              alt={img(honoursWall).note}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="overflow-hidden rounded-xl bg-white">
            <img
              src={`/images/${honoursPanel}`}
              alt="Honours and qualifications panel listing every certificate held"
              class="mx-auto h-full w-auto object-contain"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 self-start">
          {certificates.slice(0, 4).map((f) => (
            <div class="overflow-hidden rounded-lg bg-white p-2">
              <img src={`/images/${f}`} alt={img(f).note} class="h-full w-full object-contain" loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>

      <div class="mt-6 grid grid-cols-3 gap-4 sm:grid-cols-5">
        {certificates.slice(4).map((f) => (
          <div class="overflow-hidden rounded-lg bg-white p-1.5">
            <img src={`/images/${f}`} alt={img(f).note} class="h-full w-full object-contain" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>

      <p class="mt-6 text-xs text-steel-500">
        Certificate images are reproduced at catalogue resolution. Full-size scans and validity dates are
        available on request for vendor qualification files.
      </p>
    </div>
  </section>

  {
    exportBanner && (
      <section class="section">
        <div class="container-x">
          <div class="grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
            <div>
              <p class="eyebrow">Export</p>
              <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
                Seventy years of manufacturing experience, shipped to forty countries
              </h2>
              <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
                Equipment has been exported to Eastern Europe, the CIS, Mongolia, South Korea, Japan,
                South America, Africa and Southeast Asia. Export documentation, CE marking on selected
                models, and English, Russian and Spanish technical manuals are standard on export orders.
              </p>
              <ul class="mt-5 space-y-2 text-sm text-steel-700">
                {[
                  'Wooden crating to ISPM 15 for container shipment',
                  'Split shipment planning for sites with restricted access',
                  'Commissioning engineer on site, with visa and travel handled by us',
                  'Spare parts held for 10 years after the last unit of a model ships',
                ].map((t) => (
                  <li class="flex gap-2.5">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ember-500" />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="overflow-hidden rounded-xl">
              <img src={`/images/${exportBanner}`} alt={img(exportBanner).note} class="h-full w-full object-cover" loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section pt-0">
    <div class="container-x">
      <div class="grid items-center gap-10 rounded-xl border border-steel-200 bg-white p-8 sm:p-10 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="eyebrow">The catalogue</p>
          <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">
            Everything on this site comes from one document
          </h2>
          <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-steel-700">
            The 2026 wheat milling catalogue: 29 pages covering company profile, workshop capacity,
            the complete plant range from 200 kg/h to 500 t/d, and every cleaning and milling machine
            with its parameter table. Every photograph and caption on this site is taken from it.
          </p>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-steel-600">
            Ask for the PDF, or tell us what you are building and we will send only the pages that
            apply to your case.
          </p>
          <a href="/contact/" class="btn-primary mt-5">Request the catalogue</a>
        </div>
        <div class="flex items-end justify-center gap-4">
          <img
            src={`/images/${coverFile}`}
            alt="2026 Haiyun wheat milling catalogue — front cover"
            class="w-28 rounded-md shadow-lg sm:w-36"
            loading="lazy"
            decoding="async"
          />
          <img
            src={`/images/${backCoverFile}`}
            alt="2026 Haiyun wheat milling catalogue — back cover"
            class="w-28 rounded-md shadow-lg sm:w-36"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <CTABand heading="Come and see the workshop" body="We encourage buyers to visit before placing a large order. Factory acceptance testing with a customer witness is available on any plant above 20 t/d." />
</PageLayout>
