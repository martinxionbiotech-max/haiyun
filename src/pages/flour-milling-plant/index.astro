---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { plantSeries } from '../../data/plants.js';

const groups = [
  {
    title: 'Entry level — 200 kg/h to 18 t/d',
    note: 'Single-frame units and small plants. No tower, minimal civil works, commissioning in days.',
    items: plantSeries.filter((p) => ['small-unit', 'double-unit', 'five-unit', 'stone-mill'].includes(p.id)),
  },
  {
    title: 'Commercial — 20 to 60 t/d',
    note: 'Full cleaning sections, plansifters, purifiers, multi-grade production. The core of the market.',
    items: plantSeries.filter((p) => ['plant-20-30', 'plant-40-60'].includes(p.id)),
  },
  {
    title: 'Industrial — 60 to 500 t/d',
    note: 'Storey-typed turnkey plants with guaranteed tonnage, extraction and power consumption per tonne.',
    items: plantSeries.filter((p) => ['plant-100-500'].includes(p.id)),
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Wheat Flour Milling Plants, 200 kg/h to 500 t/d',
  description:
    'Complete wheat flour milling plants from 200 kg/h single units to 500 t/d turnkey installations. Capacity tables, flow sheets and selection guidance.',
};
---

<PageLayout
  title="Wheat Flour Milling Plants — 200 kg/h to 500 t/d"
  description="Compare complete wheat flour milling plants across six capacity classes: 200 kg/h units, 16–18 t/d mini mills, 20–60 t/d commercial plants and 60–500 t/d turnkey installations. Full parameter tables and flow sheets."
  schema={[schema]}
>
  <PageHero
    eyebrow="Plant range"
    title="Wheat flour milling plants, 200 kg/h to 500 t/d"
    subtitle="Seven plant architectures, thirty-plus standard configurations. Every one is delivered with a documented cleaning flow sheet, milling flow sheet and a measured power consumption per tonne."
    image="/images/p06_01.jpg"
    imageAlt="6FTDP-100T wheat flour production line, complete installation"
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">How to use this page</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          Capacity decides the architecture. Architecture decides the cost.
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
          A flour plant is not a product you buy — it is an architecture you commit to. Below 18 t/d you can
          build inside a shed with a concrete slab. Above 40 t/d you need a purifier, which means you need
          a flow sheet, which means you need a building designed around the flow sheet. Above 100 t/d the
          building <em>is</em> the machine: storey-typed, gravity-fed, engineered as one system.
        </p>
        <p class="mt-3 text-[15px] leading-relaxed text-steel-700">
          That is why the plant range is grouped by architecture rather than by price. Choose the group
          that matches your tonnage, then choose the model inside it by your building, your power supply
          and your product mix.
        </p>
      </div>
    </div>
  </section>

  {groups.map((group) => (
    <section class="pb-16">
      <div class="container-x">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-steel-200 pb-4">
          <h2 class="font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">{group.title}</h2>
          <p class="text-sm text-steel-500">{group.note}</p>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {group.items.map((p) => (
            <a href={`/flour-milling-plant/${p.slug}/`} class="card group flex flex-col p-6">
              <p class="text-[11px] font-bold uppercase tracking-widest text-ember-600">{p.scale}</p>
              <h3 class="mt-2 font-display text-xl font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
                {p.name}
              </h3>
              <p class="mt-1 text-xs font-medium text-steel-500">{p.altName}</p>
              <p class="mt-3 text-sm leading-relaxed text-steel-600">{p.tagline}</p>
              <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-steel-100 pt-4 text-sm">
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-steel-500">Capacity</dt>
                  <dd class="font-bold text-steel-900">{p.capacity}</dd>
                </div>
                <div>
                  <dt class="text-[11px] uppercase tracking-wide text-steel-500">Models</dt>
                  <dd class="font-bold text-steel-900">{p.models.length}</dd>
                </div>
              </dl>
              <span class="mt-4 text-sm font-semibold text-ember-700">View specifications →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section bg-steel-50">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">Selection matrix</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          What each capacity class actually requires
        </h2>
      </div>
      <div class="prose-hy mt-8">
        <table>
          <thead>
            <tr>
              <th>Capacity</th>
              <th>Building</th>
              <th>Cleaning</th>
              <th>Milling</th>
              <th>Sifting</th>
              <th>Staff/shift</th>
              <th>Typical lead time</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>200–450 kg/h</td><td>Slab + shed</td><td>Optional single stage</td><td>1–2 stands</td><td>Integrated</td><td>1</td><td>30–45 days</td></tr>
            <tr><td>16–18 t/d</td><td>10 × 5 × 3.5 m bay</td><td>Destoner + scourer + washer</td><td>2 stands, 3B2M</td><td>Cone or twin-bin</td><td>3</td><td>60–80 days</td></tr>
            <tr><td>20–30 t/d</td><td>12–18 × 5–6 m</td><td>Full dry section</td><td>5–10 stands, 3B2M–4B4M</td><td>2 twin-bin</td><td>3–4</td><td>80–100 days</td></tr>
            <tr><td>40–60 t/d</td><td>18–24 × 8 × 8 m</td><td>Full dry + 2 scourers</td><td>8–12 stands, 3B4M1S–4B5M1S1T</td><td>High square + purifier</td><td>4–6</td><td>100–130 days</td></tr>
            <tr><td>60–500 t/d</td><td>Storey-typed tower</td><td>3-sift / 2-scour / 2-destone / 2-dampen</td><td>Multi-pass, purifier banks</td><td>High square banks</td><td>8–30</td><td>8–11 months</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTABand body="Send us your target tonnage, wheat specification, building dimensions and available power. We reply with a flow sheet, an equipment list and a budget range within 12 working hours." />
</PageLayout>
