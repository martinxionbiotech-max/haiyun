---
import PlantDetail from '../../components/pages/PlantDetail.astro';
import { plantSeries } from '../../data/plants.js';

export async function getStaticPaths() {
  return plantSeries.map((p) => ({ params: { slug: p.slug }, props: { plant: p } }));
}

const { plant } = Astro.props;
---

<PlantDetail plant={plant} lang="en" />
