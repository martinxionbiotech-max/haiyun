---
import PageLayout from '../layouts/PageLayout.astro';
import CTABand from '../components/CTABand.astro';
import { plantSeries } from '../data/plants.js';
import { site } from '../data/site.js';
import { getCollection } from 'astro:content';

const all = await getCollection('knowledge');
const pillars = all.filter((p) => p.data.type === 'pillar').sort((a, b) => a.data.order - b.data.order);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Haiyun — Wheat Flour Milling Plants 10–500 t/d',
  description: site.description,
  about: { '@id': `${site.url}/#organization` },
};
---

<PageLayout
  title="Wheat Flour Milling Plants 10–500 t/d — Manufacturer Since 1963"
  description="Haiyun designs, manufactures and commissions complete wheat flour milling plants from 10 to 500 tonnes per day. 60+ years of grain machinery experience, 100+ patents, ISO 9001:2015, exported to 40+ countries."
  schema={[schema]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-steel-950">
    <img src="/images/p06_01.jpg" alt="6FTDP-100T wheat flour production line — complete plant view" class="absolute inset-0 h-full w-full object-cover opacity-25" />
    <div class="absolute inset-0 bg-gradient-to-br from-steel-950 via-steel-950/92 to-steel-900/60"></div>
    <div class="absolute inset-0 grid-lines opacity-30"></div>

    <div class="container-x relative py-20 sm:py-24 lg:py-32">
      <div class="max-w-3xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-ember-300">
          <span class="h-1.5 w-1.5 rounded-full bg-ember-500"></span>
          Manufacturing since 1963 · Former Shandong Flour Machinery Factory
        </p>
        <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl">
          Wheat flour plants.<br />
          <span class="text-ember-500">10 to 500 tonnes a day.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-steel-300">
          We design the flow sheet, manufacture the machines, erect the steel, commission the plant and
          train your operators. One contract, one guarantee: the tonnage and the extraction written on the
          performance test.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/" class="btn-primary">Get a flow sheet & quote</a>
          <a href="/flour-milling-plant/" class="btn-ghost-light">Compare plant classes</a>
        </div>
      </div>
    </div>

    <div class="relative border-t border-white/10 bg-steel-950/70 backdrop-blur">
      <div class="container-x grid grid-cols-2 divide-x divide-white/10 py-6 md:grid-cols-4">
        {[
          ['60+', 'years manufacturing'],
          ['100+', 'patented designs'],
          ['40+', 'export markets'],
          ['500 t/d', 'largest plant built'],
        ].map(([n, l]) => (
          <div class="px-4 text-center">
            <p class="font-display text-3xl font-bold text-white sm:text-4xl">{n}</p>
            <p class="mt-1 text-[11px] uppercase tracking-widest text-steel-400">{l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CAPACITY LADDER -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">Plant range</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          Choose by tonnage, not by catalogue page
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
          Every capacity class implies a different building, a different flow sheet and a different
          operating team. The links below open the full parameter tables, process diagrams and selection
          guidance for each.
        </p>
      </div>

      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {plantSeries.map((p) => (
          <a href={`/flour-milling-plant/${p.slug}/`} class="card group flex flex-col p-6">
            <div class="flex items-baseline justify-between gap-3">
              <p class="font-display text-2xl font-bold uppercase leading-none text-ember-600">{p.capacity}</p>
              <p class="text-[10px] font-bold uppercase tracking-widest text-steel-400">{p.scale}</p>
            </div>
            <h3 class="mt-3 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
              {p.name}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-steel-600">{p.tagline}</p>
            <p class="mt-4 text-xs font-semibold text-steel-500">{p.models.length} standard models →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY HAIYUN -->
  <section class="section bg-steel-50">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow">Why mills buy from us</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          Sixty years of one thing: grain machinery.
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
          The company's predecessor was the Shandong Flour Machinery Factory. That means our engineering
          lineage runs back to the era when a flour mill was assembled from castings made on site. What
          survived from that period is a bias toward over-building: heavier frames, replaceable wear parts,
          and machines that a local workshop can repair.
        </p>
        <p class="mt-3 text-[15px] leading-relaxed text-steel-700">
          What changed is precision. Raw material now arrives as laser-cut plate; roll housings are
          machined on CNC centres. The result is a plant that costs what a mid-market plant costs and
          holds tolerance like a premium one.
        </p>
        <a href="/about/" class="mt-6 inline-flex text-sm font-bold text-ember-700 hover:text-ember-800">
          About the factory →
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Flow sheet included', 'Every quotation includes a cleaning and milling flow diagram — not just a price list.'],
          ['Guaranteed tonnage', 'Contracted output and extraction, verified over a 72-hour performance test.'],
          ['Spares on the shelf', 'Roll packs, screens, beaters and bearings kept in stock for 10 years post-delivery.'],
          ['Operator training', 'Two to six weeks on site, plus remote support for the first harvest season.'],
        ].map(([t, d]) => (
          <div class="rounded-xl border border-steel-200 bg-white p-5 shadow-card">
            <h3 class="text-sm font-bold text-steel-900">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-600">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EQUIPMENT PREVIEW -->
  <section class="section">
    <div class="container-x">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Equipment</p>
          <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
            22 machine families, one supply chain
          </h2>
        </div>
        <a href="/equipment/" class="text-sm font-bold text-ember-700 hover:text-ember-800">Full catalogue →</a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['/equipment/gravity-destoner/', 'Gravity Destoner', 'TQSF', '1–22 t/h'],
          ['/equipment/fmfq-double-roller-mill/', 'Double Roller Mill', 'FMFQ(S)', 'Φ250 × 500–1000'],
          ['/equipment/high-square-plansifter/', 'High Square Plansifter', 'FSFG', '22–52.7 m²'],
          ['/equipment/purifier/', 'Purifier', 'FQFD', '1.4–3.5 t/h'],
        ].map(([href, name, model, cap]) => (
          <a href={href} class="card group p-5">
            <p class="text-[10px] font-bold uppercase tracking-widest text-ember-600">{model}</p>
            <h3 class="mt-2 text-sm font-bold leading-snug text-steel-900 group-hover:text-ember-700">{name}</h3>
            <p class="mt-2 text-xs text-steel-500">{cap}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- KNOWLEDGE -->
  <section class="section bg-steel-950">
    <div class="container-x">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow-light">Knowledge centre</p>
          <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl">
            The engineering we would want a supplier to send us
          </h2>
          <p class="mt-3 text-[15px] leading-relaxed text-steel-400">
            Six handbooks and thirty-six articles on plant sizing, cleaning, flow sheets, stone milling,
            quality control and plant economics. No gatekeeping.
          </p>
        </div>
        <a href="/knowledge/" class="text-sm font-bold text-ember-400 hover:text-ember-300">All handbooks →</a>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {pillars.map((p) => (
          <a href={`/knowledge/${p.id}/`} class="group rounded-xl border border-steel-800 bg-steel-900 p-6 transition hover:border-ember-700">
            <p class="text-[10px] font-bold uppercase tracking-widest text-ember-500">Handbook {String(p.data.order).padStart(2, '0')}</p>
            <h3 class="mt-2 text-base font-bold leading-snug text-white group-hover:text-ember-400">{p.data.title}</h3>
            <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-steel-400">{p.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">How a project runs</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          From enquiry to first flour
        </h2>
      </div>
      <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {[
          ['Enquiry & data collection', 'Wheat specification, target tonnage, building dimensions, power supply, product mix.'],
          ['Flow sheet & quotation', 'Cleaning diagram, milling diagram, equipment list, power budget, budget price.'],
          ['Engineering & approval', 'Layout drawings, foundation loads, electrical single-line, P&ID. Customer sign-off.'],
          ['Manufacture', '6–18 weeks depending on class. Factory acceptance test with customer witness option.'],
          ['Civil & erection', 'Foundation, steel or building works, machine setting, alignment, piping, wiring.'],
          ['Commissioning & training', 'Dry run, load test, 72-hour performance verification, operator and maintenance training.'],
        ].map(([t, d], i) => (
          <li class="rounded-xl border border-steel-200 p-5">
            <p class="font-display text-2xl font-bold text-ember-500">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-sm font-bold text-steel-900">{t}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-600">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CTABand heading="Send your tonnage. Get a flow sheet in 12 working hours." />
</PageLayout>
