---
import PageLayout from '../layouts/PageLayout.astro';
import HomeContent from '../components/pages/HomeContent.astro';
import { site } from '../data/site.js';
import { getUI } from '../i18n/ui.js';

const t = getUI('en');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Haiyun — Wheat Flour Milling Plants 10–500 t/d',
  description: site.description,
  about: { '@id': `${site.url}/#organization` },
};
---

<PageLayout
  title="Flour Milling Plants 10–500 t/d — Manufacturer Since 1963"
  description="Haiyun designs, builds and commissions wheat flour milling plants from 10 to 500 t/d: flow sheet, machinery, installation and commissioning."
  schema={[schema]}
  lang="en"
>
  <HomeContent lang="en" />
</PageLayout>
