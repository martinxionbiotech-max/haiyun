---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Figure from '../../components/Figure.astro';
import CTABand from '../../components/CTABand.astro';
import { projects } from '../../data/projects.js';
import { img } from '../../data/images.js';
import { site } from '../../data/site.js';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const heroFile = project.files[0];
const restFiles = project.files.slice(1);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: project.title,
    description: project.summary,
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    datePublished: `${project.year}-01-01`,
    dateModified: '2026-11-07',
    about: {
      '@type': 'Place',
      name: project.location,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects/` },
      { '@type': 'ListItem', position: 3, name: project.shortTitle, item: `${site.url}/projects/${project.slug}/` },
    ],
  },
];
---

<PageLayout
  title={`${project.title} — Project Record`}
  description={`${project.summary} Constraints, design decisions and measured results from a ${project.scope.toLowerCase()} project in ${project.region}.`}
  image={`/images/${heroFile}`}
  schema={schema}
>
  <PageHero
    eyebrow={`${project.scope} · ${project.year}`}
    title={project.title}
    subtitle={project.summary}
    image={`/images/${heroFile}`}
    imageAlt={img(heroFile).note}
  />

  <section class="border-b border-steel-200 bg-steel-900">
    <div class="container-x grid grid-cols-2 gap-y-6 py-8 md:grid-cols-3 lg:grid-cols-6">
      {
        project.figures.map(([k, v]) => (
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-ember-400">{k}</p>
            <p class="mt-1 font-display text-lg font-bold leading-tight text-white">{v}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <nav class="mb-6 text-xs text-steel-500" aria-label="Breadcrumb">
          <a href="/projects/" class="hover:text-ember-700">Projects</a>
          <span class="mx-1.5">/</span>
          <span class="text-steel-700">{project.shortTitle}</span>
        </nav>

        <p class="text-sm font-medium text-ember-700">{project.cn} · {project.location}</p>

        <h2 class="mt-8 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
          The brief
        </h2>
        <div class="mt-3 space-y-3">
          {project.brief.map((p) => <p class="text-[16px] leading-relaxed text-steel-700">{p}</p>)}
        </div>

        <h2 class="mt-12 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
          What constrained the design
        </h2>
        <p class="mt-2 text-sm text-steel-500">
          Four constraints that shaped the plant more than the capacity figure did.
        </p>
        <div class="mt-5 space-y-4">
          {
            project.constraints.map((c, i) => (
              <div class="rounded-lg border border-steel-200 bg-white p-5">
                <div class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded bg-steel-900 font-display text-xs font-bold text-white">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="font-display text-base font-bold uppercase tracking-tight text-steel-900">
                      {c.title}
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-steel-700">{c.body}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <h2 class="mt-12 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
          What was built
        </h2>
        <div class="mt-4 overflow-hidden rounded-lg border border-steel-200">
          <table class="w-full border-collapse text-sm">
            <tbody>
              {
                project.design.map((d) => (
                  <tr class="even:bg-steel-50/60">
                    <th class="w-40 border-b border-steel-100 px-4 py-3 text-left align-top text-xs font-bold uppercase tracking-wide text-steel-800">
                      {d.label}
                    </th>
                    <td class="border-b border-steel-100 px-4 py-3 text-steel-700">{d.value}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <h2 class="mt-12 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
          Measured outcome
        </h2>
        <div class="mt-3 space-y-3">
          {project.outcome.map((p) => <p class="text-[16px] leading-relaxed text-steel-700">{p}</p>)}
        </div>

        <h2 class="mt-12 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
          What we would do differently
        </h2>
        <p class="mt-2 text-sm text-steel-500">
          The honest section. Every project teaches something that was not in the specification.
        </p>
        <ul class="mt-4 space-y-3">
          {
            project.lessons.map((l) => (
              <li class="flex gap-3 rounded-lg bg-steel-50 p-4 text-sm leading-relaxed text-steel-700">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-ember-500" />
                <span>{l}</span>
              </li>
            ))
          }
        </ul>

        {
          restFiles.length > 0 && (
            <div class="mt-12">
              <p class="text-[11px] font-bold uppercase tracking-widest text-steel-500">
                From the brochure
              </p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {restFiles.map((f, i) => (
                  <Figure file={f} ratio="4/3" index={i + 2} />
                ))}
              </div>
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-xl border border-steel-200 bg-steel-900 p-6 text-white">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ember-400">Project at a glance</p>
          <dl class="mt-4 space-y-3 border-t border-steel-800 pt-4 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">Location</dt>
              <dd class="text-right font-semibold">{project.region}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">Year</dt>
              <dd class="text-right font-semibold">{project.year}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">Capacity</dt>
              <dd class="text-right font-semibold">{project.figures[0][1]}</dd>
            </div>
          </dl>
          <p class="mt-4 border-t border-steel-800 pt-4 text-xs leading-relaxed text-steel-400">
            {project.scope}
          </p>
          <a href="/contact/" class="btn-primary mt-5 w-full justify-center">Discuss a similar plant</a>
        </div>

        <div class="mt-6 rounded-xl border border-steel-200 p-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-steel-500">Other projects</p>
          <ul class="mt-4 space-y-3 text-sm">
            {
              others.map((o) => (
                <li>
                  <a href={`/projects/${o.slug}/`} class="group block">
                    <span class="block font-semibold text-steel-800 group-hover:text-ember-700">
                      {o.shortTitle}
                    </span>
                    <span class="block text-xs text-steel-500">{o.region} · {o.year}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/projects/" class="mt-4 inline-block text-xs font-bold text-ember-700 hover:text-ember-800">
            All projects →
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CTABand
    heading="Planning a plant of this size?"
    body="Send us your target capacity, wheat specification and site constraints. We will tell you what a plant like this one would need — and what we would change if we built it today."
  />
</PageLayout>
