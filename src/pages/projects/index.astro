---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Figure from '../../components/Figure.astro';
import CTABand from '../../components/CTABand.astro';
import { img } from '../../data/images.js';
import { projectImages } from '../../data/gallery.js';
import { projects } from '../../data/projects.js';

const stats = [
  ['500 t/d', 'Largest plant delivered'],
  ['40+', 'Export destinations'],
  ['1963', 'Manufacturing lineage begins'],
  ['100+', 'Patents held'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Reference Flour Milling Projects',
  description:
    'Reference installations of Haiyun wheat flour milling plants in China and export markets, from 30 t/d to 500 t/d.',
};
---

<PageLayout
  title="Reference Projects — Flour Milling Plants 30 to 500 t/d"
  description="Reference installations: 500 t/d and 300 t/d turnkey plants, 200 t/d plants in Xinjiang and Shandong, and the flow sheets behind them. With full tables."
  image={`/images/${projectImages.yengisar300[0]}`}
  schema={[schema]}
>
  <PageHero
    eyebrow="Reference projects"
    title="Plants we built, running where you can visit them"
    subtitle="A selection of installations in China and export markets. Full reference contact details are available to qualified buyers on request — we do not publish customer phone numbers."
    image={`/images/${projectImages.yengisar300[0]}`}
    imageAlt={img(projectImages.yengisar300[0]).note}
  />

  <section class="bg-steel-900">
    <div class="container-x grid grid-cols-2 divide-x divide-steel-800 py-8 md:grid-cols-4">
      {stats.map(([n, l]) => (
        <div class="px-4 text-center">
          <p class="font-display text-3xl font-bold text-white sm:text-4xl">{n}</p>
          <p class="mt-1 text-[11px] uppercase tracking-widest text-steel-400">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container-x space-y-14">
      {projects.map((p, i) => (
        <article class="grid gap-8 lg:grid-cols-[1.1fr_1fr]">
          <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
            {p.files.length === 1 ? (
              <Figure file={p.files[0]} ratio="4/3" showCaption={false} />
            ) : (
              <div class="grid gap-4">
                <Figure file={p.files[0]} ratio="16/9" showCaption={false} />
                <div class="grid grid-cols-2 gap-4">
                  {p.files.slice(1).map((f) => (
                    <Figure file={f} ratio="4/3" showCaption={false} />
                  ))}
                </div>
              </div>
            )}
            <p class="mt-3 text-[11px] leading-snug text-steel-500">
              {img(p.files[0]).caption}
            </p>
          </div>

          <div class={i % 2 === 1 ? 'lg:order-1' : ''}>
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded bg-steel-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-steel-600">
                {p.scope}
              </span>
              <span class="text-xs font-semibold text-steel-400">{p.year}</span>
            </div>
            <h2 class="mt-3 font-display text-2xl font-bold uppercase leading-tight text-steel-900 sm:text-3xl">
              <a href={`/projects/${p.slug}/`} class="hover:text-ember-700">{p.title}</a>
            </h2>
            <p class="mt-1 text-sm font-medium text-ember-700">{p.cn} · {p.location}</p>
            <p class="mt-4 text-[15px] leading-relaxed text-steel-700">{p.summary}</p>

            <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-steel-200 pt-5 text-sm">
              {p.figures.map(([k, v]) => (
                <div class="flex justify-between gap-3 border-b border-steel-100 pb-2">
                  <dt class="text-steel-500">{k}</dt>
                  <dd class="text-right font-semibold text-steel-900">{v}</dd>
                </div>
              ))}
            </dl>

            <a
              href={`/projects/${p.slug}/`}
              class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-ember-700 hover:text-ember-800"
            >
              Read the full project record
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-steel-50">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">Capacity table</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          What each capacity class actually requires
        </h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">
          Installed power, specific consumption and building envelope by daily capacity. These are the
          figures an architect and an electrical engineer need before a single drawing is issued.
        </p>
      </div>

      <div class="mt-8 overflow-hidden rounded-xl border border-steel-200 bg-white">
        <table class="w-full text-sm">
          <thead class="bg-steel-900 text-white">
            <tr>
              {['Capacity', 'Installed power', 'Specific power', 'Building envelope (L×W×H)'].map((h) => (
                <th class="px-4 py-3 text-left text-[11px] font-bold uppercase tracking-widest">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-steel-100">
            {[
              ['80 t/d', '190 kW', '70–74 kWh/t', '30 × 7 × 12.5 m'],
              ['100 t/d', '240 kW', '70–74 kWh/t', '35 × 7 × 12.5 m'],
              ['120 t/d', '308 kW', '70–74 kWh/t', '35 × 7.5 × 18.5 m'],
              ['200 t/d', '420 kW', '68–72 kWh/t', '40 × 8 × 18.5 m'],
              ['300 t/d', '920 kW', '67–71 kWh/t', '48 × 9 × 21 m'],
              ['500 t/d', '1,650 kW', '65–70 kWh/t', '60 × 10 × 24 m'],
            ].map((row) => (
              <tr class="hover:bg-steel-50">
                {row.map((c, j) => (
                  <td class={`px-4 py-3 ${j === 0 ? 'font-semibold text-steel-900' : 'text-steel-700'}`}>{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-steel-500">
        Figures assume 380 V / 50 Hz supply, wheat at 12.5% incoming moisture and 76% extraction.
        Envelope excludes intake pit, finished goods store and office block. The 80–120 t/d rows are
        reproduced from the catalogue capacity table; 200–500 t/d are plant-specific as-built figures.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <Figure file={projectImages.capacityTable[0]} ratio="16/9" index={1} />
        <div class="rounded-xl border border-steel-200 bg-white p-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-steel-500">A note on references</p>
          <p class="mt-3 text-sm leading-relaxed text-steel-700">
            We will provide contact details for two or three plants of comparable size and geography once
            a project reaches serious discussion. We ask the same of our customers — nobody wants
            unsolicited calls from strangers about their mill.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-steel-700">
            If you would rather see a plant in person before committing, we can arrange a visit to a
            running installation of comparable capacity and configuration.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABand heading="Want to visit a plant of your size before you commit?" body="Tell us your tonnage and country and we will identify the closest comparable installation, then arrange the visit." />
</PageLayout>
