---
interface Props {
  lang: string;
  kind: 'equipment' | 'category' | 'contact' | 'about' | 'home';
  item?: { name?: string; model?: string; stage?: string };
}

const { lang, kind, item } = Astro.props;
const show = lang === 'ru' || lang === 'ar';

const ruEquipment = {
  eyebrow: 'Техническая справка',
  title: 'Как читать эту страницу',
  p1: `Модель ${item?.name ?? ''} (${item?.model ?? ''}) относится к этапу «${item?.stage ?? ''}». Таблица выше показывает стандартные параметры; фактическая производительность зависит от зерна, влажности, помола и доступной мощности. Перед заказом уточните, какие значения являются паспортными, а какие — ориентировочными для вашей схемы.`,
  p2:
    'Если вы сравниваете несколько машин, сначала зафиксируйте производительность, затем проверьте мощность, площадь сита или длину вальцов и требования к обслуживанию. Не сравнивайте цену без одинаковой комплектации и одинаковых условий испытаний.',
  p3:
    'Для нестандартной задачи отправьте спецификацию: зерно, требуемую производительность, доступную мощность и ограничения по площадке. Инженер предложит конфигурацию и подтвердит сроки после проверки.',
};

const arEquipment = {
  eyebrow: 'ملاحظة فنية',
  title: 'كيف تقرأ هذه الصفحة',
  p1: `الطراز ${item?.name ?? ''} (${item?.model ?? ''}) مخصص لمرحلة «${item?.stage ?? ''}». يوضح الجدول أعلاه القيم القياسية؛ لكن الإنتاج الفعلي يعتمد على القمح والرطوبة والطحن والقدرة المتاحة. قبل الطلب، تأكد من القيم المضمونة ومن ظروف الاختبار.`,
  p2:
    'عند مقارنة أكثر من ماكينة، ثبّت الإنتاجية أولًا، ثم قارن القدرة ومساحة الغربال أو طول الدرفيل ومتطلبات الصيانة. لا تقارن السعر قبل توحيد التجهيز وظروف الاختبار.',
  p3:
    'للمشاريع غير القياسية، أرسل المواصفات: نوع القمح، الإنتاجية المطلوبة، القدرة المتاحة وقيود الموقع. سيقترح المهندس التكوين ويؤكد الجدول بعد المراجعة.',
};

const ruCategory = {
  eyebrow: 'Выбор оборудования',
  title: 'С чего начать выбор',
  p1:
    'В этом разделе собраны машины одного этапа. Начинайте не с модели, а с задачи: какое зерно, какая производительность, сколько проходов и какая доступная мощность. Затем проверьте, вписывается ли машина в существующую схему и площадку.',
  p2:
    'Сравнивайте одинаковые условия: производительность, мощность, размеры, комплектацию и обслуживание. Если данные в таблице неполные, запросите подтверждение у инженера — не подставляйте предположения.',
  p3:
    'Для новой линии запросите схему с числом проходов, балансом помола и расчётом мощности. Отдельная машина не заменяет проверенную технологическую схему.',
};

const arCategory = {
  eyebrow: 'اختيار المعدات',
  title: 'من أين تبدأ الاختيار',
  p1:
    'يجمع هذا القسم ماكينات مرحلة واحدة. ابدأ من المهمة لا من الطراز: نوع القمح، الإنتاجية المطلوبة، عدد المرورات، والقدرة المتاحة. ثم تحقق من ملاءمة الماكينة للمخطط والموقع.',
  p2:
    'قارن الظروف نفسها: الإنتاجية والقدرة والأبعاد والتجهيز والصيانة. إذا كانت بيانات الجدول ناقصة، اطلب تأكيدًا من المهندس ولا تفترض القيم.',
  p3:
    'للخط الجديد، اطلب مخططًا بعدد المرورات وتوازن الطحن وحساب القدرة. الماكينة المنفردة لا تغني عن مخطط تقني مُتحقق منه.',
};

const ruContact = {
  eyebrow: 'Подготовка запроса',
  title: 'Что указать в запросе',
  p1:
    'Чтобы получить точное предложение, укажите страну, тип зерна, требуемую производительность, доступную мощность, площадь участка и желаемую форму оплаты. Приложите анализ зерна и план площадки, если они есть.',
  p2:
    'Если вы сравниваете предложения, пришлите одинаковую спецификацию: производительность, выход муки, число проходов, комплектацию и требования к документации. Иначе цены будут относиться к разным объёмам работ.',
  p3:
    'Для запасных частей укажите модель, серийный номер или размеры детали. Для шеф-монтажа — страну, сроки и ограничения по площадке.',
};

const arContact = {
  eyebrow: 'تحضير الطلب',
  title: 'ما الذي يجب ذكره في الطلب',
  p1:
    'للحصول على عرض دقيق، اذكر الدولة ونوع القمح والإنتاجية المطلوبة والقدرة المتاحة ومساحة الموقع وطريقة الدفع المفضلة. أرفق تحليل القمح ومخطط الموقع إن توفرا.',
  p2:
    'عند مقارنة العروض، أرسل المواصفات نفسها: الإنتاجية، نسبة الاستخراج، عدد المرورات، التجهيز ومتطلبات الوثائق. وإلا فكل عرض سعر يخص نطاق عمل مختلفًا.',
  p3:
    'لقطع الغيار، اذكر الطراز أو الرقم التسلسلي أو أبعاد القطعة. لأعمال التركيب، اذكر الدولة والجدول الزمني وقيود الموقع.',
};

const ruAbout = {
  eyebrow: 'О предприятии',
  title: 'Производственная база и история',
  p1:
    'Производственная площадка расположена в зоне экономического развития Сышуй, Цзинин, провинция Шаньдун. На сайте указаны площадь участка, цеха, число сотрудников и патенты; перед аудитом запросите подтверждающие документы.',
  p2:
    'Историческая справка: предприятие зарегистрировано в 2010 году и продолжает производственную традицию бывшего Шаньдунского завода мельничного оборудования, выпускавшего продукцию с 1963 года. Это разные даты: юридическое лицо и историческая преемственность.',
};

const arAbout = {
  eyebrow: 'عن الشركة',
  title: 'قاعدة الإنتاج والتاريخ',
  p1:
    'يقع موقع الإنتاج في منطقة سيشوي للتنمية الاقتصادية، جينينغ، مقاطعة شاندونغ. تعرض الصفحة مساحة الموقع والورش وعدد الموظفين وبراءات الاختراع؛ اطلب الوثائق المؤيدة قبل التدقيق.',
  p2:
    'ملاحظة تاريخية: تأسست الشركة قانونيًا عام 2010، وتواصل إرث مصنع شاندونغ السابق لماكينات الطحن الذي بدأ الإنتاج عام 1963. التاريخان مختلفان: الكيان القانوني والإرث الصناعي.',
};

const ruHome = {
  eyebrow: 'Как мы работаем',
  title: 'От анализа зерна до пуска',
  p1:
    'Проект начинается с анализа зерна и требований к муке, затем определяется схема, мощность и состав оборудования. После согласования спецификации стороны фиксируют объём поставки, документы и график.',
  p2:
    'Если вы только изучаете рынок, начните с раздела «Мельничные заводы» и запросите предварительный расчёт. Для точного предложения нужны страна, зерно, производительность и доступная мощность.',
};

const arHome = {
  eyebrow: 'كيف نعمل',
  title: 'من تحليل القمح إلى التشغيل',
  p1:
    'يبدأ المشروع بتحليل القمح ومتطلبات الدقيق، ثم يُحدد المخطط والقدرة ومكونات المعدات. بعد اعتماد المواصفات، يثبّت الطرفان نطاق التوريد والوثائق والجدول الزمني.',
  p2:
    'إذا كنت تستكشف السوق فقط، ابدأ من قسم مصانع الطحن واطلب تقديرًا أوليًا. للحصول على عرض دقيق، نحتاج الدولة ونوع القمح والإنتاجية والقدرة المتاحة.',
};

const data = {
  ru: { equipment: ruEquipment, category: ruCategory, contact: ruContact, about: ruAbout, home: ruHome },
  ar: { equipment: arEquipment, category: arCategory, contact: arContact, about: arAbout, home: arHome },
};
const c = data[lang]?.[kind];
---

{show && c && (
  <section class="section pt-0">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">
        {c.title}
      </h2>
      <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-steel-700">
        <p>{c.p1}</p>
        <p>{c.p2}</p>
        {'p3' in c && <p>{c.p3}</p>}
      </div>
    </div>
  </section>
)}
