---
import { site } from '../data/site.js';
import { plantSeries } from '../data/plants.js';

const year = new Date().getFullYear();
---

<footer class="mt-20 bg-steel-950 text-steel-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-ember-600 text-white">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 20h18M6 20V9l6-5 6 5v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="13" r="2.6" stroke="currentColor" stroke-width="1.8"/>
          </svg>
        </span>
        <span class="leading-tight">
          <span class="block font-display text-xl font-bold uppercase tracking-wide text-white">Haiyun</span>
          <span class="block text-[10px] font-semibold uppercase tracking-[0.16em] text-ember-400">Flour Milling Systems</span>
        </span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-steel-400">
        {site.legalName} — building complete wheat flour milling plants from 10 to 500 tonnes per day since 1963.
        Design, manufacture, installation, commissioning and operator training under one contract.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {site.certifications.map((c) => (
          <li class="rounded border border-steel-800 bg-steel-900 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-steel-300">
            {c}
          </li>
        ))}
      </ul>
      <div class="mt-6 space-y-2 text-sm">
        <p><a href={`tel:${site.phoneRaw}`} class="font-semibold text-white hover:text-ember-400">{site.phone}</a></p>
        <p><a href={`tel:${site.mobileRaw}`} class="hover:text-white">{site.mobile} (WhatsApp)</a></p>
        <p><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></p>
        <p class="text-steel-400">{site.address.full}</p>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">Flour Plants</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {plantSeries.slice(0, 7).map((p) => (
          <li><a href={`/flour-milling-plant/${p.slug}/`} class="hover:text-white">{p.name.replace(' 6FSZ', '').replace(' 6FTDP', '')}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">Equipment</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/equipment/cleaning-equipment/" class="hover:text-white">Cleaning equipment</a></li>
        <li><a href="/equipment/flour-milling-equipment/" class="hover:text-white">Milling equipment</a></li>
        <li><a href="/equipment/gravity-destoner/" class="hover:text-white">Gravity destoner</a></li>
        <li><a href="/equipment/fmfq-double-roller-mill/" class="hover:text-white">FMFQ roller mill</a></li>
        <li><a href="/equipment/high-square-plansifter/" class="hover:text-white">High square plansifter</a></li>
        <li><a href="/equipment/purifier/" class="hover:text-white">Purifier</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">Company</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href="/about/" class="hover:text-white">About Haiyun</a></li>
        <li><a href="/projects/" class="hover:text-white">Reference projects</a></li>
        <li><a href="/knowledge/" class="hover:text-white">Knowledge centre</a></li>
        <li><a href="/solutions/" class="hover:text-white">Solutions by market</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact & RFQ</a></li>
        <li><a href="/llms.txt" class="hover:text-white">llms.txt</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-steel-800">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-steel-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.legalName}. All rights reserved. 鲁ICP备13005965号</p>
      <p class="flex gap-4">
        <a href="/privacy/" class="hover:text-steel-300">Privacy</a>
        <a href="/terms/" class="hover:text-steel-300">Terms</a>
        <a href="/sitemap-index.xml" class="hover:text-steel-300">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
