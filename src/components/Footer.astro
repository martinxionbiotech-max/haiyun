---
import { site } from '../data/site.js';
import { plantSeries } from '../data/plants.js';
import { getUI } from '../i18n/ui.js';
import { defaultLocale, localeMeta, locales, switchLocalePath, localizePath } from '../i18n/config.js';

const year = new Date().getFullYear();
const lang = Astro.props.lang ?? 'en';
const t = getUI(lang);
const href = (p) => localizePath(lang, p);
const current = Astro.url.pathname;
---

<footer class="mt-20 bg-steel-950 text-steel-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="grid h-10 w-10 place-items-center rounded-lg bg-ember-600 text-white">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 20h18M6 20V9l6-5 6 5v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="13" r="2.6" stroke="currentColor" stroke-width="1.8"/>
          </svg>
        </span>
        <span class="leading-tight">
          <span class="block font-display text-xl font-bold uppercase tracking-wide text-white">Haiyun</span>
          <span class="block text-[10px] font-semibold uppercase tracking-[0.16em] text-ember-400">{t.brandSub}</span>
        </span>
      </div>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-steel-400">
        {site.legalName} — {t.footer.about}
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {site.certifications.map((c) => (
          <li class="rounded border border-steel-800 bg-steel-900 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-steel-300">
            {c}
          </li>
        ))}
      </ul>
      <div class="mt-6 space-y-2 text-sm">
        <p class="text-steel-300">
          <span class="text-steel-500">Phone / WeChat:</span>{' '}
          <a href={`tel:${site.phoneRaw}`} class="font-semibold text-white hover:text-ember-400" dir="ltr">{site.phone}</a>
        </p>
        <div class="pt-1">
          <a
            href={`https://wa.me/${site.whatsapp}`}
            rel="noopener"
            class="inline-flex items-center gap-2 rounded bg-ember-600 px-3.5 py-2 text-xs font-bold uppercase tracking-wide text-white transition hover:bg-ember-700"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/>
            </svg>
            Chat on WhatsApp
          </a>
        </div>
        <p class="pt-2 text-[11px] font-bold uppercase tracking-widest text-steel-500">Email</p>
        <ul class="space-y-1.5">
          {site.emails.map((e) => (
            <li>
              <a href={`mailto:${e.address}`} class="hover:text-white">{e.address}</a>
            </li>
          ))}
        </ul>
        <p class="pt-2 text-steel-400">{site.address.full}</p>
      </div>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">{t.footer.plantsHead}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {plantSeries.slice(0, 7).map((p) => (
          <li><a href={href(`/flour-milling-plant/${p.slug}/`)} class="hover:text-white">{p.name.replace(' 6FSZ', '').replace(' 6FTDP', '')}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">{t.footer.equipHead}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={href('/equipment/cleaning-equipment/')} class="hover:text-white">{t.footer.cleaning}</a></li>
        <li><a href={href('/equipment/flour-milling-equipment/')} class="hover:text-white">{t.footer.milling}</a></li>
        <li><a href={href('/equipment/gravity-destoner/')} class="hover:text-white">TQSF</a></li>
        <li><a href={href('/equipment/fmfq-double-roller-mill/')} class="hover:text-white">FMFQ(S)</a></li>
        <li><a href={href('/equipment/high-square-plansifter/')} class="hover:text-white">FSFG</a></li>
        <li><a href={href('/equipment/purifier/')} class="hover:text-white">FQFD</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">{t.footer.companyHead}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={href('/about/')} class="hover:text-white">{t.footer.aboutLink}</a></li>
        <li><a href={href('/projects/')} class="hover:text-white">{t.footer.projectsLink}</a></li>
        <li><a href={href('/knowledge/')} class="hover:text-white">{t.footer.kbLink}</a></li>
        <li><a href={href('/about/methodology/')} class="hover:text-white">{t.footer.methodLink}</a></li>
        <li><a href={href('/solutions/')} class="hover:text-white">{t.footer.solutionsLink}</a></li>
        <li><a href={href('/contact/')} class="hover:text-white">{t.footer.contactLink}</a></li>
        <li><a href="/llms.txt" class="hover:text-white">llms.txt</a></li>
      </ul>

      <div class="mt-6 border-t border-steel-800 pt-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-steel-500">{t.langLabel}</p>
        <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs">
          {locales.map((l) => (
            <li>
              <a
                href={switchLocalePath(current, l)}
                lang={l}
                hreflang={l}
                class:list={[l === lang ? 'font-bold text-white' : 'text-steel-400 hover:text-white']}
              >
                {localeMeta[l].short}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-steel-800">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-steel-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.legalName}. {t.footer.rights} 鲁ICP备13005965号</p>
      <nav aria-label="Legal and compliance" class="flex max-w-2xl flex-wrap gap-x-4 gap-y-2 text-[11px]">
        <a href="/privacy/" class="hover:text-steel-300">Privacy</a>
        <a href="/cookie-policy/" class="hover:text-steel-300">Cookie Policy</a>
        <a href="/terms/" class="hover:text-steel-300">Terms of Use</a>
        <a href="/disclaimer/" class="hover:text-steel-300">Disclaimer</a>
        <a href="/editorial-policy/" class="hover:text-steel-300">Editorial Policy</a>
        <a href="/accessibility/" class="hover:text-steel-300">Accessibility</a>
        <a href="/export-compliance/" class="hover:text-steel-300">Export Compliance</a>
        <a href="/compliance/" class="hover:text-steel-300">Compliance &amp; Ethics</a>
        <a href="/company-information/" class="hover:text-steel-300">Company Information</a>
        <a href="/sitemap-index.xml" class="hover:text-steel-300">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>
