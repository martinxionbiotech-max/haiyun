---
import { site } from '../data/site.js';
import { getUI } from '../i18n/ui.js';
import { localizePath } from '../i18n/config.js';

const lang = Astro.props.lang ?? 'en';
const t = getUI(lang);
const href = (p) => localizePath(lang, p);

const { heading = t.home.ctaBand, body } = Astro.props;
const eyebrow =
  lang === 'ru' ? 'Следующий шаг' : lang === 'es' ? 'Siguiente paso' : lang === 'ar' ? 'الخطوة التالية' : 'Next step';
---

<section class="bg-steel-900">
  <div class="container-x py-14 sm:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[2fr_1fr]">
      <div>
        <p class="eyebrow-light">{eyebrow}</p>
        <h2 class="mt-2 max-w-2xl font-display text-3xl font-bold uppercase leading-tight tracking-tight text-white sm:text-4xl">
          {heading}
        </h2>
        <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-steel-300">
          {body || t.home.ctaBandBody}
        </p>
      </div>
      <div class="flex flex-col gap-3 lg:items-end">
        <a href={href('/contact/')} class="btn-primary w-full justify-center lg:w-auto">{t.cta.quote}</a>
        <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn-ghost-light w-full justify-center lg:w-auto">
          WhatsApp
        </a>
        <a href={`mailto:${site.email}`} class="text-center text-sm font-medium text-steel-300 hover:text-white lg:text-end">
          {site.email}
        </a>
      </div>
    </div>
  </div>
</section>
