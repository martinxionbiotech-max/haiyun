---
import { site } from '../data/site.js';
const { heading = 'Tell us your tonnage. We will send the flow sheet.', body } = Astro.props;
---

<section class="bg-steel-900">
  <div class="container-x py-14 sm:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[2fr_1fr]">
      <div>
        <p class="eyebrow-light">Next step</p>
        <h2 class="mt-2 max-w-2xl font-display text-3xl font-bold uppercase leading-tight tracking-tight text-white sm:text-4xl">
          {heading}
        </h2>
        <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-steel-300">
          {body || 'Send us: daily capacity target, wheat type and quality, available building dimensions, and local power supply. We reply within 12 working hours with a preliminary flow sheet, equipment list and budget range — no obligation.'}
        </p>
      </div>
      <div class="flex flex-col gap-3 lg:items-end">
        <a href="/contact/" class="btn-primary w-full justify-center lg:w-auto">Request quotation</a>
        <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn-ghost-light w-full justify-center lg:w-auto">
          WhatsApp {site.mobile}
        </a>
        <a href={`mailto:${site.email}`} class="text-center text-sm font-medium text-steel-300 hover:text-white lg:text-right">
          {site.email}
        </a>
      </div>
    </div>
  </div>
</section>
