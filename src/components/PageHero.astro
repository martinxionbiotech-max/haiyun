---
import { site } from '../data/site.js';
const { title, subtitle, image, imageAlt = '', eyebrow } = Astro.props;
---

<section class="relative overflow-hidden bg-steel-950">
  {image && (
    <img src={image} alt={imageAlt} class="absolute inset-0 h-full w-full object-cover opacity-30" loading="eager" />
  )}
  <div class="absolute inset-0 bg-gradient-to-br from-steel-950 via-steel-950/90 to-steel-900/70"></div>
  <div class="absolute inset-0 grid-lines opacity-40"></div>

  <div class="container-x relative py-16 sm:py-20 lg:py-24">
    {eyebrow && <p class="eyebrow-light">{eyebrow}</p>}
    <h1 class="mt-3 max-w-4xl font-display text-4xl font-bold uppercase leading-[1.05] tracking-tight text-white sm:text-5xl lg:text-6xl">
      {title}
    </h1>
    {subtitle && <p class="mt-5 max-w-3xl text-lg leading-relaxed text-steel-300">{subtitle}</p>}
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/contact/" class="btn-primary">Request a technical proposal</a>
      <a href={`https://wa.me/${site.whatsapp}`} class="btn-ghost-light" rel="noopener">WhatsApp engineering</a>
    </div>
    <ul class="mt-10 grid gap-3 text-sm text-steel-300 sm:grid-cols-2 lg:grid-cols-4">
      <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-ember-500"></span>60+ years manufacturing</li>
      <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-ember-500"></span>10–500 t/d capacity range</li>
      <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-ember-500"></span>100+ patents</li>
      <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-ember-500"></span>Turnkey commissioning</li>
    </ul>
  </div>
</section>
