---
import { getDetailUI } from '../i18n/detail.js';
import { localizePath } from '../i18n/config.js';

const { items = [], faq = [], title, lang = 'en' } = Astro.props;

const t = getDetailUI(lang);
const heading = title ?? t.faqTitle;
const contactHref = localizePath(lang, '/contact/');

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

{faq.length > 0 && (
  <section class="section hairline" aria-labelledby="faq-heading">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_2fr]">
        <div>
          <p class="eyebrow">{t.answers}</p>
          <h2 id="faq-heading" class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
            {heading}
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-steel-600">{t.faqNote}</p>
          <a href={contactHref} class="mt-5 inline-flex text-sm font-semibold text-ember-700 hover:text-ember-800">
            {t.askEngineer} →
          </a>
        </div>
        <dl class="divide-y divide-steel-200">
          {faq.map((f) => (
            <div class="py-5 first:pt-0">
              <dt class="text-base font-bold text-steel-900">{f.q}</dt>
              <dd class="mt-2 text-[15px] leading-relaxed text-steel-700">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
)}

{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
