---
// Figure — a single brochure image with its captions.
// English caption is the primary line (this is an English-language site);
// the original Chinese caption is kept below it in small type so no source
// text is lost and buyers who read Chinese can match it to the printed brochure.
import { img } from '../data/images.js';

const {
  file,
  caption,
  alt,
  ratio = '4/3',
  rounded = 'rounded-lg',
  eager = false,
  showCaption = true,
  showOriginal = true,
  captionPrefix = 'Fig.',
  index,
  class: className = '',
} = Astro.props;

const meta = img(file);
const text = alt ?? meta.note ?? caption ?? '';
const primary = caption || meta.captionEn || meta.caption || '';
const original = meta.caption && meta.caption !== primary ? meta.caption : '';
const src = `/images/${file}`;
---

<figure class={`group ${className}`}>
  <div class={`overflow-hidden ${rounded} bg-steel-100`} style={`aspect-ratio: ${ratio}`}>
    <img
      src={src}
      alt={text}
      width={meta.w || undefined}
      height={meta.h || undefined}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>
  {showCaption && primary && (
    <figcaption class="mt-2 text-[11px] leading-snug">
      <span class="flex gap-2">
        {index != null && (
          <span class="shrink-0 font-bold uppercase tracking-wider text-ember-600">
            {captionPrefix} {index}
          </span>
        )}
        <span class="font-medium text-steel-700">{primary}</span>
      </span>
      {showOriginal && original && (
        <span class="mt-0.5 block text-[10px] leading-snug text-steel-400">{original}</span>
      )}
    </figcaption>
  )}
</figure>
