---
// Shared body for the two equipment category pages.
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../PageHero.astro';
import CTABand from '../CTABand.astro';
import Figure from '../Figure.astro';
import { equipmentByCategory } from '../../data/equipment.js';
import { getDetailUI } from '../../i18n/detail.js';
import { site as siteCfg } from '../../data/site.js';
import { localizePath } from '../../i18n/config.js';

const { category, lang = 'en', copy } = Astro.props;

const t = getDetailUI(lang);
const href = (p) => localizePath(lang, p);

const items = equipmentByCategory(category);
const gallery = copy.gallery ?? [];
const catName = category === 'cleaning' ? t.cleaning : t.milling;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.title,
  description: copy.sub,
  inLanguage: lang,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${e.name} (${e.model})`,
      url: new URL(href(`/equipment/${e.slug}/`), siteCfg.url).href,
    })),
  },
};
---

<PageLayout title={copy.title} description={copy.sub} lang={lang} schema={[schema]} image={copy.hero}>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.title}
    subtitle={copy.sub}
    image={copy.hero}
    imageAlt={copy.title}
    lang={lang}
  />

  <section class="section">
    <div class="container-x">
      <div class="max-w-3xl">
        <h2 class="font-display text-3xl font-bold uppercase tracking-tight text-steel-900">{copy.sectionTitle}</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-steel-700">{copy.sectionBody}</p>
      </div>

      {copy.sequence && (
        <ol class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {copy.sequence.map((s, i) => (
            <li class="flex items-center gap-3 rounded-lg border border-steel-200 bg-white px-4 py-3 shadow-card">
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-ember-600 text-[11px] font-bold text-white">{i + 1}</span>
              <span class="text-sm font-medium text-steel-800">{s}</span>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <section class="section hairline pt-0">
    <div class="container-x">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {items.map((e) => (
          <a href={href(`/equipment/${e.slug}/`)} class="card group flex flex-col p-6">
            <div class="flex items-start justify-between gap-3">
              <span class="rounded bg-steel-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-steel-600">{e.stage}</span>
              <span class="text-[11px] font-bold text-ember-600" dir="ltr">{e.model}</span>
            </div>
            <h3 class="mt-3 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">{e.name}</h3>
            <p class="mt-0.5 text-xs text-steel-500">{e.altName}</p>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-steel-600">{e.tagline}</p>
            <span class="mt-4 text-sm font-semibold text-ember-700">{copy.specLink} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="section pt-0">
        <div class="container-x">
          <p class="eyebrow">{t.fromBrochure}</p>
          <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">
            {copy.galleryTitle}
          </h2>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-steel-600">{copy.galleryNote}</p>
          <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {gallery.map((f, i) => (
              <Figure file={f} ratio="4/3" index={i + 1} showNote />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABand heading={copy.cta} lang={lang} />
</PageLayout>
