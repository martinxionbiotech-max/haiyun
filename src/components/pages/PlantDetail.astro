---
// Shared plant detail body. Both the English page and the /ru|es|ar/ pages use
// this, so the four locales cannot drift structurally — only the strings differ.
import { fitDescription, fitTitle } from '../../lib/seo.js';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../PageHero.astro';
import Figure from '../Figure.astro';
import FAQ from '../FAQ.astro';
import CTABand from '../CTABand.astro';
import CapacityBasis from '../CapacityBasis.astro';
import { getDetailUI } from '../../i18n/detail.js';
import { localizePath } from '../../i18n/config.js';
import { site } from '../../data/site.js';
import { plantGallery } from '../../data/gallery.js';
import { plantSeries } from '../../data/plants.js';
import { getPlantContent } from '../../i18n/content.js';

const { plant, lang = 'en' } = Astro.props;

const t = getDetailUI(lang);
const href = (p) => localizePath(lang, p);

const index = plantSeries.findIndex((p) => p.slug === plant.slug);
const others = plantSeries.filter((p) => p.slug !== plant.slug).map((p) => getPlantContent(lang, p.slug));
const next = getPlantContent(lang, plantSeries[(index + 1) % plantSeries.length].slug);
const shots = plantGallery[plant.slug] ?? { hero: null, gallery: [] };
const heroFile = shots.hero;
const galleryFiles = shots.gallery.filter((f) => f !== heroFile);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: plant.name,
    serviceType: 'Complete wheat flour milling plant',
    description: plant.tagline,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: site.markets.map((m) => ({ '@type': 'Place', name: m })),
    url: `${site.url}${href(`/flour-milling-plant/${plant.slug}/`)}`,
    '@id': `${site.url}${href(`/flour-milling-plant/${plant.slug}/`)}#service`,
    image: [heroFile ? `${site.url}/images/${heroFile}` : `${site.url}/og-default.jpg`],
    mainEntityOfPage: { '@id': `${site.url}${href(`/flour-milling-plant/${plant.slug}/`)}` },
    additionalProperty: [
      { '@type': 'PropertyValue', name: t.capacityLabel, value: plant.capacity },
      { '@type': 'PropertyValue', name: t.modelsLabel, value: String(plant.models.length) },
      { '@type': 'PropertyValue', name: t.scaleClass, value: plant.scale },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: plant.name,
    description: plant.tagline,
    inLanguage: lang,
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    datePublished: '2026-01-15',
    dateModified: '2026-11-07',
  },
];

const pageTitle = plant.name.includes(plant.capacity) ? plant.name : `${plant.name} — ${plant.capacity}`;
const pageDesc = fitDescription(`${plant.tagline} ${plant.name}: ${plant.capacity}, ${plant.models.length} ${t.configurations}.`, t.metaSuffix);
---

<PageLayout
  title={fitTitle(pageTitle)}
  description={pageDesc}
  image={heroFile ? `/images/${heroFile}` : undefined}
  schema={schema}
  lang={lang}
>
  <PageHero
    eyebrow={`${plant.scale} · ${plant.capacity}`}
    title={plant.name}
    subtitle={plant.tagline}
    image={heroFile ? `/images/${heroFile}` : undefined}
    imageAlt={plant.name}
    lang={lang}
  />

  <CapacityBasis compact />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <p class="eyebrow">{t.overview}</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900">
          {t.whatThisPlantIs}
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-steel-700">{plant.intro}</p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {plant.highlights.map((h) => (
            <div class="flex gap-3 rounded-lg border border-steel-200 bg-steel-50/60 p-4">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-ember-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/>
              </svg>
              <p class="text-sm leading-relaxed text-steel-700">{h}</p>
            </div>
          ))}
        </div>

        <h2 class="mt-14 font-display text-3xl font-bold uppercase tracking-tight text-steel-900">
          {t.standardModels}
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-steel-600">{t.nominalNote}</p>

        <div class="mt-6 overflow-x-auto rounded-lg border border-steel-200">
          <table class="w-full border-collapse text-sm">
            <thead class="bg-steel-50 text-start">
              <tr>
                <th class="border-b border-steel-200 px-4 py-3 font-bold text-steel-900">{t.paramHeaders.model}</th>
                <th class="border-b border-steel-200 px-4 py-3 font-bold text-steel-900">{t.paramHeaders.capacity}</th>
                <th class="border-b border-steel-200 px-4 py-3 font-bold text-steel-900">{t.paramHeaders.power}</th>
                <th class="border-b border-steel-200 px-4 py-3 font-bold text-steel-900">{t.paramHeaders.weight}</th>
                <th class="border-b border-steel-200 px-4 py-3 font-bold text-steel-900">{t.paramHeaders.configuration}</th>
              </tr>
            </thead>
            <tbody>
              {plant.models.map((m) => (
                <tr class="even:bg-steel-50/50">
                  <td class="border-b border-steel-100 px-4 py-3 font-bold text-steel-900" dir="ltr">{m.model}</td>
                  <td class="border-b border-steel-100 px-4 py-3 text-steel-700">{m.capacity}</td>
                  <td class="border-b border-steel-100 px-4 py-3 text-steel-700">{m.power}</td>
                  <td class="border-b border-steel-100 px-4 py-3 text-steel-700">
                    {m.specificPower ? `${m.specificPower} · ` : ''}{m.weight && m.weight !== '—' ? `${m.weight} · ` : ''}{m.dims}
                  </td>
                  <td class="border-b border-steel-100 px-4 py-3 text-steel-600">{m.note || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 class="mt-14 font-display text-3xl font-bold uppercase tracking-tight text-steel-900">{t.processFlow}</h2>
        <ol class="mt-5 grid gap-2 sm:grid-cols-2">
          {plant.flow.map((step, i) => (
            <li class="flex items-center gap-3 rounded-lg border border-steel-200 bg-white px-4 py-3 shadow-card">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-steel-900 text-xs font-bold text-white">
                {i + 1}
              </span>
              <span class="text-sm font-medium text-steel-800">{step}</span>
            </li>
          ))}
        </ol>

        <h2 class="mt-14 font-display text-3xl font-bold uppercase tracking-tight text-steel-900">{t.howToSelect}</h2>
        <div class="mt-4 rounded-lg border-s-4 border-ember-500 bg-ember-50 p-5">
          <p class="text-[15px] leading-relaxed text-steel-800">{plant.selection}</p>
        </div>

        <h2 class="mt-14 font-display text-3xl font-bold uppercase tracking-tight text-steel-900">{t.typicalApplications}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {plant.applications.map((a) => (
            <li class="chip">{a}</li>
          ))}
        </ul>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-xl border border-steel-200 bg-steel-50 p-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ember-600">{t.quickSpec}</p>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-3 border-b border-steel-200 pb-3">
              <dt class="text-steel-600">{t.capacityLabel}</dt>
              <dd class="text-end font-bold text-steel-900">{plant.capacity}</dd>
            </div>
            <div class="flex justify-between gap-3 border-b border-steel-200 pb-3">
              <dt class="text-steel-600">{t.modelsLabel}</dt>
              <dd class="text-end font-bold text-steel-900">{plant.models.length}</dd>
            </div>
            <div class="flex justify-between gap-3 border-b border-steel-200 pb-3">
              <dt class="text-steel-600">{t.scaleClass}</dt>
              <dd class="text-end font-bold text-steel-900">{plant.scale}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-steel-600">{t.leadTime}</dt>
              <dd class="text-end font-bold text-steel-900">{t.leadTimeValue}</dd>
            </div>
          </dl>
          <a href={href('/contact/')} class="btn-primary mt-6 w-full justify-center">{t.requestPricing}</a>
          <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn-outline mt-2 w-full justify-center">
            {t.whatsappEngineering}
          </a>
          <p class="mt-4 text-center text-xs text-steel-500">{t.responseTime}</p>
        </div>

        <div class="mt-6 rounded-xl border border-steel-200 p-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-steel-500">{t.otherPlantClasses}</p>
          <ul class="mt-4 space-y-3 text-sm">
            {others.slice(0, 5).map((o) => (
              <li>
                <a href={href(`/flour-milling-plant/${o.slug}/`)} class="group block">
                  <span class="block font-semibold text-steel-800 group-hover:text-ember-700">{o.name}</span>
                  <span class="block text-xs text-steel-500">{o.capacity}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    galleryFiles.length > 0 && (
      <section class="section bg-steel-50">
        <div class="container-x">
          <p class="eyebrow">{t.fromBrochure}</p>
          <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">
            {plant.name}
          </h2>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-steel-600">{t.galleryNote}</p>
          <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {galleryFiles.map((f, i) => (
              <Figure file={f} ratio="4/3" index={i + 1} showNote alt={lang !== 'en' ? `${plant.name} — ${i + 1}` : undefined} caption={lang !== 'en' ? `${plant.name} — ${i + 1}` : undefined} showOriginal={lang === 'en'} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FAQ faq={plant.faq} lang={lang} />

  <section class="section pt-0">
    <div class="container-x">
      <div class="rounded-xl bg-steel-900 p-8 text-white sm:p-10">
        <p class="eyebrow-light">{t.continue}</p>
        <h2 class="mt-2 font-display text-2xl font-bold uppercase text-white sm:text-3xl">
          {t.next}: {next.name}
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-steel-300">{next.tagline} — {next.capacity}</p>
        <a href={href(`/flour-milling-plant/${next.slug}/`)} class="mt-5 inline-flex text-sm font-bold text-ember-400 hover:text-ember-300">
          {t.view} {next.name} →
        </a>
      </div>
    </div>
  </section>

  <CTABand lang={lang} />
</PageLayout>
