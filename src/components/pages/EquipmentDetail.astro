---
// Shared equipment detail body, used by the English page and the /ru|es|ar/
// pages. Spec tables stay in src/data/equipment.js — translations only carry
// prose, so a machine's numbers can never differ between locales.
import { fitDescription, fitTitle } from '../../lib/seo.js';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../PageHero.astro';
import Figure from '../Figure.astro';
import FAQ from '../FAQ.astro';
import CTABand from '../CTABand.astro';
import { getDetailUI, specHeaderMap } from '../../i18n/detail.js';
import { getSelectionContent } from '../../i18n/content.js';
import { localizePath } from '../../i18n/config.js';
import { site } from '../../data/site.js';
import { equipmentByCategory } from '../../data/equipment.js';
import { selectionBySlug } from '../../data/selection.js';
import { VS } from '../../data/vs.js';
import { equipment as allEquipment } from '../../data/equipment.js';
import { equipmentGallery } from '../../data/gallery.js';
import { equipmentReading, knowledgeTitles } from '../../data/equipment-reading.js';
import LocalizedContext from '../LocalizedContext.astro';

const { item, lang = 'en' } = Astro.props;

const t = getDetailUI(lang);
const href = (p) => localizePath(lang, p);

const related = equipmentByCategory(item.category)
  .filter((e) => e.slug !== item.slug)
  .slice(0, 4);

const selGroup = getSelectionContent(lang, selectionBySlug[item.slug]);
const selfOption = selGroup?.options.find((o) => o.slug === item.slug);
const rivals = selGroup?.options.filter((o) => o.slug !== item.slug) ?? [];

const reading = (equipmentReading[item.slug] ?? [])
  .filter((s) => knowledgeTitles[s])
  .map((s) => ({ slug: s, title: knowledgeTitles[s] }));

const shots = equipmentGallery[item.slug] ?? { hero: null, gallery: [] };
const heroFile = shots.hero;
const galleryFiles = shots.gallery.filter((f) => f !== heroFile);

const isCleaning = item.category === 'cleaning';
const catName = isCleaning ? t.cleaning : t.milling;
const catHref = isCleaning ? '/equipment/cleaning-equipment/' : '/equipment/flour-milling-equipment/';

const vsEntry = VS[item.slug];
const vsItem = vsEntry ? allEquipment.find((e) => e.slug === vsEntry.slug) : null;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${item.name} (${item.model})`,
    description: item.tagline,
    brand: { '@type': 'Brand', name: 'HAIYUN' },
    manufacturer: { '@id': `${site.url}/#organization` },
    category: isCleaning ? t.cleaningCategory : t.millingCategory,
    model: item.model,
    sku: item.model ?? item.slug,
    url: `${site.url}${href(`/equipment/${item.slug}/`)}`,
    '@id': `${site.url}${href(`/equipment/${item.slug}/`)}#product`,
    image: [heroFile ? `${site.url}/images/${heroFile}` : `${site.url}/og-default.jpg`],
    mainEntityOfPage: { '@id': `${site.url}${href(`/equipment/${item.slug}/`)}` },
    // Published price band for the equipment range. The exact price is quoted
    // per configuration, so the markup carries an aggregate range rather than a
    // single figure; Google requires at least one price field in offers.
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: 5000,
      highPrice: 10000,
      offerCount: 1,
      itemCondition: 'https://schema.org/NewCondition',
      availability: 'https://schema.org/InStock',
      businessFunction: 'http://purl.org/goodrelations/v1#Sell',
      seller: { '@id': `${site.url}/#organization` },
      url: `${site.url}${href('/contact/')}`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: item.name,
    inLanguage: lang,
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
    datePublished: '2026-01-15',
    dateModified: '2026-11-07',
  },
];
---

<PageLayout
  title={fitTitle(lang === 'en' ? (item.seoTitle ?? (item.model ? `${item.name} — ${item.model}` : item.name)) : (item.model ? `${item.name} — ${item.model}` : item.name))}
  description={fitDescription(`${item.tagline} ${item.name} (${item.model}) — ${t.technicalParameters}, ${t.selectionGuidance}, ${t.maintenance}.`, t.metaSuffix)}
  image={heroFile ? `/images/${heroFile}` : undefined}
  schema={schema}
  lang={lang}
>
  <PageHero
    eyebrow={`${item.stage} · ${t.paramHeaders.model} ${item.model}`}
    title={item.name}
    subtitle={item.tagline}
    image={heroFile ? `/images/${heroFile}` : undefined}
    imageAlt={`${item.name} ${item.model}`}
    lang={lang}
  />

  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <nav class="mb-6 text-xs text-steel-500" aria-label="Breadcrumb">
          <a href={href('/equipment/')} class="hover:text-ember-700">{t.equipment}</a>
          <span class="mx-1.5">/</span>
          <a href={href(catHref)} class="hover:text-ember-700">{catName}</a>
          <span class="mx-1.5">/</span>
          <span class="text-steel-700">{item.name}</span>
        </nav>

        <h2 class="font-display text-2xl font-bold uppercase tracking-tight text-steel-900">{t.whatItDoes}</h2>
        <p class="mt-3 text-[16px] leading-relaxed text-steel-700">{item.intro}</p>

        <h2 class="mt-10 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
          {t.technicalParameters}
        </h2>
        <p class="mt-2 text-xs text-steel-500">{t.technicalNote}</p>
        <div class="mt-4 overflow-x-auto rounded-lg border border-steel-200">
          <table class="w-full border-collapse text-sm">
            <thead class="bg-steel-50 text-start">
              <tr>
                {item.specs.headers.map((h) => (
                  <th class="whitespace-nowrap border-b border-steel-200 px-3 py-2.5 text-start text-xs font-bold uppercase tracking-wide text-steel-800">
                    {specHeaderMap[lang]?.[h] ?? h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {item.specs.rows.map((row) => (
                <tr class="even:bg-steel-50/50">
                  {row.map((cell, i) => (
                    <td class:list={['border-b border-steel-100 px-3 py-2.5', i === 0 ? 'font-semibold text-steel-900' : 'text-steel-700']}>
                      {cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-steel-200 bg-steel-50 p-5">
            <h3 class="text-xs font-bold uppercase tracking-widest text-ember-700">{t.selectionGuidance}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-700">{item.selection}</p>
          </div>
          <div class="rounded-lg border border-steel-200 bg-white p-5 shadow-card">
            <h3 class="text-xs font-bold uppercase tracking-widest text-steel-600">{t.maintenance}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-700">{item.maintenance}</p>
          </div>
        </div>

        {lang === 'en' && item.notFor && (
          <div class="mt-4 rounded-lg border-l-4 border-ember-500 bg-ember-50/40 p-5">
            <h3 class="text-xs font-bold uppercase tracking-widest text-ember-700">When not to choose this machine</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-700">{item.notFor}</p>
          </div>
        )}

        {lang === 'en' && vsEntry && vsItem && (
          <div class="mt-6 rounded-lg border-l-4 border-ember-500 bg-ember-50/40 p-5">
            <h3 class="text-xs font-bold uppercase tracking-widest text-ember-700">{t.alternative}: {vsItem.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-700">{vsEntry.note}</p>
            <p class="mt-2 text-sm"><a class="font-semibold text-ember-700 underline" href={`${lang === 'en' ? '' : '/' + lang}/equipment/${vsItem.slug}/`}>{vsItem.name} →</a></p>
          </div>
        )}

        {
          selGroup && (
            <div class="mt-12 rounded-xl border border-steel-200 bg-white p-6 shadow-card sm:p-8">
              <p class="text-[11px] font-bold uppercase tracking-widest text-ember-700">{t.selectionCrossCheck}</p>
              <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900">
                {selGroup.title}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-steel-600">{selGroup.intro}</p>

              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-lg border-2 border-ember-500 bg-ember-50/40 p-5">
                  <p class="text-[10px] font-bold uppercase tracking-widest text-ember-700">{t.thisMachine}</p>
                  <p class="mt-1 font-display text-lg font-bold uppercase leading-tight text-steel-900">
                    {selfOption?.name ?? item.name}
                  </p>
                  <p class="text-xs text-steel-500">{selfOption?.model ?? item.model}</p>
                  <p class="mt-3 text-[13px] font-bold uppercase tracking-wide text-steel-800">{t.chooseWhen}</p>
                  <p class="mt-1 text-sm leading-relaxed text-steel-700">{selfOption?.choose}</p>
                  <p class="mt-3 text-[13px] font-bold uppercase tracking-wide text-steel-800">{t.watchOut}</p>
                  <p class="mt-1 text-sm leading-relaxed text-steel-700">{selfOption?.mind}</p>
                </div>

                {rivals.map((r) => (
                  <a
                    href={href(`/equipment/${r.slug}/`)}
                    class="group rounded-lg border border-steel-200 p-5 transition hover:border-ember-400 hover:bg-steel-50"
                  >
                    <p class="text-[10px] font-bold uppercase tracking-widest text-steel-400">{t.alternative}</p>
                    <p class="mt-1 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
                      {r.name}
                    </p>
                    <p class="text-xs text-steel-500">{r.model}</p>
                    <p class="mt-3 text-[13px] font-bold uppercase tracking-wide text-steel-800">{t.chooseWhen}</p>
                    <p class="mt-1 text-sm leading-relaxed text-steel-700">{r.choose}</p>
                    <p class="mt-3 text-[13px] font-bold uppercase tracking-wide text-steel-800">{t.watchOut}</p>
                    <p class="mt-1 text-sm leading-relaxed text-steel-700">{r.mind}</p>
                    <span class="mt-3 inline-block text-xs font-bold text-ember-700">
                      {t.open} {r.name} →
                    </span>
                  </a>
                ))}
              </div>

              <div class="mt-6 rounded-lg bg-steel-900 p-5 text-white">
                <p class="text-[10px] font-bold uppercase tracking-widest text-ember-400">{t.decisionRule}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-steel-100">{selGroup.rule}</p>
              </div>
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-xl border border-steel-200 bg-steel-900 p-6 text-white">
          <p class="text-[11px] font-bold uppercase tracking-widest text-ember-400">{t.modelSeries}</p>
          <p class="mt-2 font-display text-3xl font-bold uppercase" dir="ltr">{item.model}</p>
          <p class="mt-1 text-sm text-steel-400">{item.specs.rows.length} {t.configurations}</p>
          <dl class="mt-5 space-y-2.5 border-t border-steel-800 pt-4 text-sm">
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">{t.processStage}</dt>
              <dd class="text-end font-semibold">{item.stage}</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-steel-400">{t.category}</dt>
              <dd class="text-end font-semibold">{isCleaning ? t.cleaningShort : t.millingShort}</dd>
            </div>
          </dl>
          <a href={href('/contact/')} class="btn-primary mt-6 w-full justify-center">{t.getQuotation}</a>
          <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="btn-ghost-light mt-2 w-full justify-center">
            {t.whatsapp}
          </a>
        </div>

        <div class="mt-6 rounded-xl border border-steel-200 p-6">
          <p class="text-[11px] font-bold uppercase tracking-widest text-steel-500">{t.relatedEquipment}</p>
          <ul class="mt-4 space-y-3 text-sm">
            {related.map((r) => (
              <li>
                <a href={href(`/equipment/${r.slug}/`)} class="group block">
                  <span class="block font-semibold text-steel-800 group-hover:text-ember-700">{r.name}</span>
                  <span class="block text-xs text-steel-500">{r.model} · {r.stage}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {
    reading.length > 0 && (
      <section class="section pt-0">
        <div class="container-x">
          <div class="rounded-xl border border-steel-200 bg-steel-50 p-6 sm:p-8">
            <p class="text-[11px] font-bold uppercase tracking-widest text-ember-700">{t.furtherReading}</p>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-steel-600">{t.furtherReadingNote}</p>
            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {reading.map((r) => (
                <li>
                  <a
                    href={href(`/knowledge/${r.slug}/`)}
                    class="group flex items-start gap-3 rounded-lg border border-steel-200 bg-white p-4 transition hover:border-ember-500"
                  >
                    <span class="mt-0.5 text-ember-600">→</span>
                    <span class="text-sm font-semibold leading-snug text-steel-800 group-hover:text-ember-700">
                      {lang === 'en' ? r.title : lang === 'ru' ? 'Техническое руководство (на английском)' : lang === 'es' ? 'Guía técnica (en inglés)' : 'دليل فني (بالإنجليزية)'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <LocalizedContext lang={lang} kind="equipment" item={item} />

  <FAQ faq={item.faq} lang={lang} />

  {
    galleryFiles.length > 0 && (
      <section class="section pt-0">
        <div class="container-x">
          <p class="eyebrow">{t.fromBrochure}</p>
          <h2 class="mt-2 font-display text-2xl font-bold uppercase tracking-tight text-steel-900 sm:text-3xl">
            {item.name} {t.catalogueImages}
          </h2>
          <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-steel-600">{t.catalogueNote}</p>
          <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {galleryFiles.map((f, i) => (
              <Figure file={f} ratio="4/3" index={i + 1} showNote alt={lang !== 'en' ? `${item.name} — ${i + 1}` : undefined} caption={lang !== 'en' ? `${item.name} — ${i + 1}` : undefined} showOriginal={lang === 'en'} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTABand lang={lang} />
</PageLayout>
