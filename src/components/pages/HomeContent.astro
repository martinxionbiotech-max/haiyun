---
// Shared homepage body. Rendered by /index.astro (en) and /{lang}/index.astro
// so the four locales cannot drift apart structurally — only the strings differ.
import CTABand from '../CTABand.astro';
import { plantSeries } from '../../data/plants.js';
import { getUI } from '../../i18n/ui.js';
import { localizePath } from '../../i18n/config.js';

const lang = Astro.props.lang ?? 'en';
const t = getUI(lang);
const href = (p) => localizePath(lang, p);

const plantI18n = {
  ru: {
    'small-flour-mill-unit': 'Одна машина, три операции: помол, просеивание, подъём.',
    'double-mill-unit': 'Два вальцовых станка в одной станине с разделением муки и отрубей.',
    'five-mill-unit': 'Полная очистка плюс помол 3B2M — минимальный полноценный завод.',
    'stone-mill-unit': 'Холодный помол на жерновах при 28–30 об/мин для цельнозерновой муки.',
    '20-30tpd-flour-plant': 'Завод в один этаж для районного рынка, 3B2M–4B4M.',
    '40-60tpd-flour-plant': 'С рассевом, ситовейкой и вымольной машиной — полноценная схема.',
    '60-500tpd-flour-plant': 'Многоэтажный завод под ключ, двенадцать типоразмеров.',
  },
  es: {
    'small-flour-mill-unit': 'Una máquina, tres funciones: moler, tamizar, elevar.',
    'double-mill-unit': 'Dos molinos de cilindros en una bancada con separación de salvado.',
    'five-mill-unit': 'Limpieza completa más molienda 3B2M — la planta completa más pequeña.',
    'stone-mill-unit': 'Molienda en frío a 28–30 rpm para harina integral.',
    '20-30tpd-flour-plant': 'Planta de una sola altura para mercado comarcal, 3B2M a 4B4M.',
    '40-60tpd-flour-plant': 'Con cernidor, purificador y desmenuzadora de salvado.',
    '60-500tpd-flour-plant': 'Planta de varias alturas llave en mano, doce capacidades.',
  },
  ar: {
    'small-flour-mill-unit': 'ماكينة واحدة بثلاث وظائف: طحن، نخل، رفع.',
    'double-mill-unit': 'مطحنتا درفيل في هيكل واحد مع فصل النخالة.',
    'five-mill-unit': 'تنظيف كامل مع طحن 3B2M — أصغر مصنع متكامل.',
    'stone-mill-unit': 'طحن بارد على الحجر عند 28–30 دورة/دقيقة للدقيق الكامل.',
    '20-30tpd-flour-plant': 'مصنع بطابق واحد لسوق المنطقة، من 3B2M إلى 4B4M.',
    '40-60tpd-flour-plant': 'مع منخل ومكنة تنقية وفارزة نخالة — مخطط كامل.',
    '60-500tpd-flour-plant': 'مصنع متعدد الطوابق تسليم مفتاح، اثنتا عشرة سعة.',
  },
};

const scaleI18n = {
  ru: { 'Village / farm-level': 'Деревня / ферма', 'Small commercial': 'Малая коммерция', 'District mill': 'Районный завод', 'Artisan / premium': 'Ремесленный / премиум', 'County level': 'Уровень уезда', 'Regional': 'Региональный', 'Industrial': 'Промышленный' },
  es: { 'Village / farm-level': 'Aldea / granja', 'Small commercial': 'Pequeño comercial', 'District mill': 'Molino comarcal', 'Artisan / premium': 'Artesanal / premium', 'County level': 'Nivel provincial', 'Regional': 'Regional', 'Industrial': 'Industrial' },
  ar: { 'Village / farm-level': 'قرية / مزرعة', 'Small commercial': 'تجاري صغير', 'District mill': 'مطحن المنطقة', 'Artisan / premium': 'حرفي / ممتاز', 'County level': 'مستوى المحافظة', 'Regional': 'إقليمي', 'Industrial': 'صناعي' },
};

const tagline = (p) => plantI18n[lang]?.[p.slug] ?? p.tagline;
const scale = (p) => scaleI18n[lang]?.[p.scale] ?? p.scale;
---

<!-- HERO -->
<section class="relative overflow-hidden bg-steel-950">
  <img src="/images/p06_01.webp" alt={t.home.h1a} fetchpriority="high" width="1600" height="1563" class="absolute inset-0 h-full w-full object-cover opacity-25" />
  <div class="absolute inset-0 bg-gradient-to-br from-steel-950 via-steel-950/92 to-steel-900/60"></div>
  <div class="absolute inset-0 grid-lines opacity-30"></div>

  <div class="container-x relative py-20 sm:py-24 lg:py-32">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-ember-300">
        <span class="h-1.5 w-1.5 rounded-full bg-ember-500"></span>
        {t.home.badge}
      </p>
      <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl">
        {t.home.h1a}<br />
        <span class="text-ember-500">{t.home.h1b}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-steel-300">{t.home.lead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={href('/contact/')} class="btn-primary">{t.cta.quote}</a>
        <a href={href('/flour-milling-plant/')} class="btn-ghost-light">{t.home.ctaCompare}</a>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-steel-950/70 backdrop-blur">
    <div class="container-x grid grid-cols-2 divide-x divide-white/10 py-6 md:grid-cols-4 rtl:divide-x-reverse">
      {t.home.stats.map(([n, l]) => (
        <div class="px-4 text-center">
          <p class="font-display text-3xl font-bold text-white sm:text-4xl">{n}</p>
          <p class="mt-1 text-[11px] uppercase tracking-widest text-steel-400">{l}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CAPACITY LADDER -->
<section class="section">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.home.rangeEyebrow}</p>
      <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
        {t.home.rangeTitle}
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-steel-700">{t.home.rangeBody}</p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {plantSeries.map((p) => (
        <a href={href(`/flour-milling-plant/${p.slug}/`)} class="card group flex flex-col p-6">
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-display text-2xl font-bold uppercase leading-none text-ember-600">{p.capacity}</p>
            <p class="text-[10px] font-bold uppercase tracking-widest text-steel-400">{scale(p)}</p>
          </div>
          <h3 class="mt-3 font-display text-lg font-bold uppercase leading-tight text-steel-900 group-hover:text-ember-700">
            {p.name}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-steel-600">{tagline(p)}</p>
          <p class="mt-4 text-xs font-semibold text-steel-500">{p.models.length} {t.home.modelsLabel} →</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- WHY HAIYUN -->
<section class="section bg-steel-50">
  <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.1fr]">
    <div>
      <p class="eyebrow">{t.home.whyEyebrow}</p>
      <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
        {t.home.whyTitle}
      </h2>
      <p class="mt-4 text-[15px] leading-relaxed text-steel-700">{t.home.whyP1}</p>
      <p class="mt-3 text-[15px] leading-relaxed text-steel-700">{t.home.whyP2}</p>
      <a href={href('/about/')} class="mt-6 inline-flex text-sm font-bold text-ember-700 hover:text-ember-800">
        {t.home.whyLink} →
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {t.home.whyCards.map(([title, body]) => (
        <div class="rounded-xl border border-steel-200 bg-white p-5 shadow-card">
          <h3 class="text-sm font-bold text-steel-900">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-steel-600">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- EQUIPMENT PREVIEW -->
<section class="section">
  <div class="container-x">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.home.equipEyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
          {t.home.equipTitle}
        </h2>
      </div>
      <a href={href('/equipment/')} class="text-sm font-bold text-ember-700 hover:text-ember-800">{t.home.equipAll} →</a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['/equipment/gravity-destoner/', 'TQSF', '1–22 t/h'],
        ['/equipment/fmfq-double-roller-mill/', 'FMFQ(S)', 'Φ250 × 500–1000'],
        ['/equipment/high-square-plansifter/', 'FSFG', '22–52.7 m²'],
        ['/equipment/purifier/', 'FQFD', '1.4–3.5 t/h'],
      ].map(([path, model, cap]) => (
        <a href={href(path)} class="card group p-5">
          <p class="text-[10px] font-bold uppercase tracking-widest text-ember-600">{model}</p>
          <p class="mt-2 text-sm font-bold leading-snug text-steel-900 group-hover:text-ember-700">{model}</p>
          <p class="mt-2 text-xs text-steel-500">{cap}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- KNOWLEDGE -->
<section class="section bg-steel-950">
  <div class="container-x">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div class="max-w-2xl">
        <p class="eyebrow-light">{t.home.kbEyebrow}</p>
        <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl">
          {t.home.kbTitle}
        </h2>
        <p class="mt-3 text-[15px] leading-relaxed text-steel-400">{t.home.kbBody}</p>
      </div>
      <a href="/knowledge/" class="text-sm font-bold text-ember-400 hover:text-ember-300">{t.home.kbAll} →</a>
    </div>

    <div class="mt-8 rounded-lg border border-steel-800 bg-steel-900 p-5">
      <p class="text-xs leading-relaxed text-steel-400">
        {t.notTranslated.body}
        <a href="/knowledge/" class="ms-1 font-bold text-ember-400 hover:text-ember-300">→</a>
      </p>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="section">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.home.processEyebrow}</p>
      <h2 class="mt-2 font-display text-3xl font-bold uppercase tracking-tight text-steel-900 sm:text-4xl">
        {t.home.processTitle}
      </h2>
    </div>
    <ol class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {t.home.process.map(([title, body], i) => (
        <li class="rounded-xl border border-steel-200 p-5">
          <p class="font-display text-2xl font-bold text-ember-500">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-2 text-sm font-bold text-steel-900">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-steel-600">{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<CTABand lang={lang} heading={t.home.ctaBand} body={t.home.ctaBandBody} />
